<script is:inline>
  (() => {
    const WAIT_MS = 10000;
    const POLL_MS = 250;
    const annotations = {
      readOnlyHint: true,
      consequentialHint: false,
      untrustedContentHint: false,
    };
    let catalogPromise;
    let registrationController;

    const getContext = () => {
      if (document.modelContext && typeof document.modelContext.registerTool === 'function') return document.modelContext;
      if (navigator.modelContext && typeof navigator.modelContext.registerTool === 'function') return navigator.modelContext;
      return null;
    };

    const getCatalog = async (signal) => {
      if (signal?.aborted) throw new DOMException('The tool call was cancelled.', 'AbortError');
      if (!catalogPromise) {
        catalogPromise = fetch('/catalog.json', { signal })
          .then((response) => {
            if (!response.ok) throw new Error(`Catalog request failed with ${response.status}`);
            return response.json();
          })
          .catch((error) => {
            catalogPromise = undefined;
            throw error;
          });
      }
      return catalogPromise;
    };

    const json = (value) => JSON.stringify(value, null, 2);
    const textValue = (input, key) => String(input?.[key] ?? '').trim();
    const promptValue = (input, key) => Array.isArray(input?.[key])
      ? input[key].map((value) => String(value).trim()).filter(Boolean).join(', ')
      : textValue(input, key);
    const numberValue = (input, key, fallback, minimum, maximum) => {
      const parsed = Number(input?.[key]);
      return Number.isFinite(parsed) ? Math.min(maximum, Math.max(minimum, Math.floor(parsed))) : fallback;
    };
    const page = (items, input) => {
      const offset = numberValue(input, 'offset', 0, 0, Number.MAX_SAFE_INTEGER);
      const limit = numberValue(input, 'limit', 25, 1, 100);
      return {
        totalResults: items.length,
        offset,
        limit,
        truncated: offset + limit < items.length,
        nextOffset: offset + limit < items.length ? offset + limit : null,
        items: items.slice(offset, offset + limit),
      };
    };
    const songSummary = (song) => ({
      id: song.id,
      slug: song.slug,
      title: song.title,
      era: song.era,
      kind: song.kind,
      pageUrl: song.pageUrl,
      album: song.album ?? null,
      style: song.style ?? null,
      length: song.length ?? (song.seconds ? `${Math.floor(song.seconds / 60)}:${String(song.seconds % 60).padStart(2, '0')}` : null),
      links: song.links,
      originalTrackId: song.originalTrackId ?? null,
      originalPageUrl: song.originalPageUrl ?? null,
      reimaginedTrackIds: song.reimaginedTrackIds ?? [],
      reimaginedPageUrls: song.reimaginedPageUrls ?? [],
      createdAt: song.createdAt ?? null,
      genres: song.genres ?? [],
      imageUrl: song.imageLargeUrl ?? song.imageUrl ?? null,
      embedUrl: song.embedUrl ?? null,
      creationMethod: song.creationMethod,
      videoIds: song.videoIds ?? [],
      relatedVideoIds: song.relatedVideoIds ?? [],
    });
    const videoSummary = (video) => ({
      id: video.id,
      youtubeId: video.youtubeId,
      title: video.title,
      pageUrl: video.pageUrl,
      watchUrl: video.watchUrl,
      imageUrl: video.imageUrl,
      publishedAt: video.publishedAt,
      durationSeconds: video.durationSeconds ?? null,
      songIds: video.songIds,
      relatedSongIds: video.relatedSongIds,
    });
    const promptingSections = (guide) => ({
      fundamentals: { formula: guide.formula, example: guide.example, layers: guide.layers, fieldGuidance: guide.fieldGuidance, promptDensity: guide.promptDensity, templates: guide.templates },
      genres: guide.genreFamilies,
      instruments: guide.instrumentFamilies,
      vocals: { dimensions: guide.vocalDimensions, writing: guide.melodyAndVocalWriting, promptPatterns: guide.vocalPromptPatterns },
      rhythm: { rhythmTerms: guide.rhythmTerms, meters: guide.meters, meterGuidance: guide.meterGuidance, oddMeterPercussion: guide.oddMeterPercussion, studioMeterNote: guide.studioMeterNote, percussionDimensions: guide.percussionDimensions, percussionRecipes: guide.percussionRecipes },
      harmony: { keyGuidance: guide.keyGuidance, chordProgressions: guide.chordProgressions, harmonicLevers: guide.harmonicLevers, harmonyTerms: guide.harmonyTerms, melodicTerms: guide.melodicTerms, troubleshooting: guide.harmonyTroubleshooting },
      arrangement: { patterns: guide.arrangementPatterns, blueprints: guide.arrangementBlueprints },
      production: { sound: guide.productionFamilies, studioWorkflow: guide.studioProductionWorkflow },
      lyrics: { principles: guide.lyricPrinciples, example: guide.lyricExample },
      hybrids: { artistTranslation: guide.artistTranslation, hybridPatterns: guide.hybridPatterns, excludeSets: guide.excludeSets },
      controls: { models: guide.models, controls: guide.controls },
      troubleshooting: { general: guide.troubleshooting, diagnosis: guide.generationDiagnosis, promptLaboratory: guide.promptLaboratory },
      recipes: guide.recipes,
      vocabulary: guide.vocabulary,
      workflow: { decisions: guide.workflowDecisions, controlBoundaries: guide.controlBoundaries, projectStyleBible: guide.projectStyleBible, testProtocol: guide.testProtocol, checklist: guide.checklist, evaluation: guide.evaluation },
    });
    const searchPromptingValues = (value, query, path = [], results = []) => {
      if (typeof value === 'string') {
        if (value.toLowerCase().includes(query)) results.push({ path: path.join('.'), value });
        return results;
      }
      if (Array.isArray(value)) value.forEach((item, index) => searchPromptingValues(item, query, [...path, String(index)], results));
      else if (value && typeof value === 'object') Object.entries(value).forEach(([key, item]) => searchPromptingValues(item, query, [...path, key], results));
      return results;
    };

    const tools = [
      {
        name: 'music_overview',
        description: 'Get a concise overview of Alex Merced Music, including current counts for acoustic, electronic, reimagined, and newly generated songs. Use this first when a user asks what music is available.',
        inputSchema: { type: 'object', properties: {}, additionalProperties: false },
        execute: async (_input, signal) => {
          const catalog = await getCatalog(signal);
          return { schemaVersion: catalog.schemaVersion, updatedAt: catalog.updatedAt, counts: catalog.counts, electronic: catalog.electronic, suno: catalog.suno, mainPages: {
            explore: `${catalog.site}/songs/`, videos: `${catalog.site}/videos/`, acoustic: `${catalog.site}/acoustic/`, electronic: `${catalog.site}/electronic/`, reimagined: `${catalog.site}/reimagined/`, sunoPromptingGuide: `${catalog.site}/suno-prompting-guide/`, stories: `${catalog.site}/stories/`, listen: `${catalog.site}/listen/`, about: `${catalog.site}/about/`, webMcp: `${catalog.site}/webmcp/`,
          } };
        },
      },
      {
        name: 'get_song',
        description: 'Get one exact song record, including its canonical page, listening sources, album, and original or reimagined relationships. Use an ID or slug from another catalog tool; exact title is also accepted.',
        inputSchema: {
          type: 'object',
          properties: {
            id: { type: 'string', minLength: 1, description: 'Stable song ID.' },
            slug: { type: 'string', minLength: 1, description: 'Canonical song-page slug.' },
            title: { type: 'string', minLength: 1, description: 'Exact song title, case-insensitive.' },
          },
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const id = textValue(input, 'id');
          const slug = textValue(input, 'slug').toLowerCase();
          const title = textValue(input, 'title').toLowerCase();
          if (!id && !slug && !title) return { error: 'Provide id, slug, or title.' };
          const matches = catalog.songs.filter((song) =>
            (id && song.id === id) || (slug && song.slug === slug) || (title && song.title.toLowerCase() === title));
          return matches.length === 1
            ? { schemaVersion: catalog.schemaVersion, updatedAt: catalog.updatedAt, song: matches[0] }
            : { found: matches.length, songs: matches.map(songSummary), error: matches.length ? 'The title is ambiguous; retry with an ID or slug.' : 'No exact song matched.' };
        },
      },
      {
        name: 'search_songs',
        description: 'Search song titles and descriptions across every era. Use this for partial titles or broad discovery; filter by era, kind, album, or source and paginate large result sets.',
        inputSchema: {
          type: 'object',
          properties: {
            query: { type: 'string', minLength: 1, description: 'Words from a title or description.' },
            era: { type: 'string', enum: ['all', 'acoustic', 'electronic', 'ai'] },
            kind: { type: 'string', enum: ['all', 'archive', 'electronic', 'reimagined', 'generated'] },
            source: { type: 'string', enum: ['all', 'youtube', 'soundcloud', 'soundcloud-albums', 'reverbnation', 'suno'] },
            album: { type: 'string', minLength: 1 },
            limit: { type: 'integer', minimum: 1, maximum: 100, default: 25 },
            offset: { type: 'integer', minimum: 0, default: 0 },
          },
          required: ['query'],
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const query = textValue(input, 'query').toLowerCase();
          if (!query) return { error: 'Provide a non-empty query.' };
          const era = textValue(input, 'era') || 'all';
          const kind = textValue(input, 'kind') || 'all';
          const source = textValue(input, 'source') || 'all';
          const album = textValue(input, 'album').toLowerCase();
          const matches = catalog.songs.filter((song) =>
            `${song.title} ${song.description}`.toLowerCase().includes(query)
            && (era === 'all' || song.era === era)
            && (kind === 'all' || song.kind === kind)
            && (source === 'all' || song.links.some((link) => link.source === source))
            && (!album || song.album?.toLowerCase().includes(album)));
          return { query, filters: { era, kind, source, album: album || null }, ...page(matches.map(songSummary), input) };
        },
      },
      {
        name: 'list_songs',
        description: 'List catalog songs without requiring a search term. Use filters and pagination to browse an era, song kind, album, or hosting source without downloading the entire catalog.',
        inputSchema: {
          type: 'object',
          properties: {
            era: { type: 'string', enum: ['all', 'acoustic', 'electronic', 'ai'], default: 'all' },
            kind: { type: 'string', enum: ['all', 'archive', 'electronic', 'reimagined', 'generated'], default: 'all' },
            source: { type: 'string', enum: ['all', 'youtube', 'soundcloud', 'soundcloud-albums', 'reverbnation', 'suno'], default: 'all' },
            album: { type: 'string', minLength: 1 },
            limit: { type: 'integer', minimum: 1, maximum: 100, default: 25 },
            offset: { type: 'integer', minimum: 0, default: 0 },
          },
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const era = textValue(input, 'era') || 'all';
          const kind = textValue(input, 'kind') || 'all';
          const source = textValue(input, 'source') || 'all';
          const album = textValue(input, 'album').toLowerCase();
          const matches = catalog.songs.filter((song) =>
            (era === 'all' || song.era === era)
            && (kind === 'all' || song.kind === kind)
            && (source === 'all' || song.links.some((link) => link.source === source))
            && (!album || song.album?.toLowerCase().includes(album)));
          return { filters: { era, kind, source, album: album || null }, ...page(matches.map(songSummary), input) };
        },
      },
      {
        name: 'get_recent_songs',
        description: 'List the most recently published recordings with exact source dates, canonical pages, artwork and listening links. Use this when a user asks what is new or recent.',
        inputSchema: {
          type: 'object',
          properties: {
            kind: { type: 'string', enum: ['all', 'archive', 'electronic', 'reimagined', 'generated'], default: 'all' },
            limit: { type: 'integer', minimum: 1, maximum: 100, default: 20 },
            offset: { type: 'integer', minimum: 0, default: 0 },
          },
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const kind = textValue(input, 'kind') || 'all';
          const dated = catalog.songs.filter((song) => song.createdAt && (kind === 'all' || song.kind === kind))
            .sort((left, right) => Date.parse(right.createdAt) - Date.parse(left.createdAt));
          return { updatedAt: catalog.updatedAt, kind, ...page(dated.map(songSummary), input) };
        },
      },
      {
        name: 'list_videos',
        description: 'List and search every public video on the Alex Merced Music YouTube channel. Results include canonical video pages and matching or related song IDs.',
        inputSchema: {
          type: 'object',
          properties: {
            query: { type: 'string', minLength: 1 },
            connection: { type: 'string', enum: ['all', 'linked', 'unlinked'], default: 'all' },
            limit: { type: 'integer', minimum: 1, maximum: 100, default: 25 },
            offset: { type: 'integer', minimum: 0, default: 0 },
          },
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const query = textValue(input, 'query').toLowerCase();
          const connection = textValue(input, 'connection') || 'all';
          const matches = catalog.videos.filter((video) =>
            (!query || video.title.toLowerCase().includes(query))
            && (connection === 'all' || (connection === 'linked' && video.relatedSongIds.length) || (connection === 'unlinked' && !video.relatedSongIds.length)));
          return { query: query || null, connection, ...page(matches.map(videoSummary), input) };
        },
      },
      {
        name: 'get_video',
        description: 'Get one YouTube video with its canonical page, watch URL, metadata, matching songs and other known versions. Accept a stable video ID or YouTube ID.',
        inputSchema: { type: 'object', properties: { id: { type: 'string', minLength: 1 }, youtubeId: { type: 'string', minLength: 1 } }, additionalProperties: false },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const id = textValue(input, 'id');
          const youtubeId = textValue(input, 'youtubeId');
          if (!id && !youtubeId) return { error: 'Provide id or youtubeId.' };
          const video = catalog.videos.find((item) => item.id === id || item.youtubeId === youtubeId);
          if (!video) return { error: 'No video matched.' };
          const songsById = new Map(catalog.songs.map((song) => [song.id, song]));
          return {
            video: videoSummary(video),
            songs: video.songIds.map((songId) => songsById.get(songId)).filter(Boolean).map(songSummary),
            otherVersions: video.relatedSongIds.filter((songId) => !video.songIds.includes(songId)).map((songId) => songsById.get(songId)).filter(Boolean).map(songSummary),
          };
        },
      },
      {
        name: 'compare_versions',
        description: 'Return an acoustic original and every known reimagined version with canonical pages and verified listening links. Accept any related song ID or slug.',
        inputSchema: {
          type: 'object',
          properties: { id: { type: 'string', minLength: 1 }, slug: { type: 'string', minLength: 1 } },
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const id = textValue(input, 'id');
          const slug = textValue(input, 'slug');
          const selected = catalog.songs.find((song) => song.id === id || song.slug === slug);
          if (!selected) return { error: 'No song matched that ID or slug.' };
          const byId = new Map(catalog.songs.map((song) => [song.id, song]));
          const original = selected.originalTrackId ? byId.get(selected.originalTrackId) : selected;
          const rebuilt = (original.reimaginedTrackIds ?? []).map((relatedId) => byId.get(relatedId)).filter(Boolean);
          if (!rebuilt.length && selected.kind !== 'reimagined') return { error: 'This recording has no cataloged reimagined version.', song: songSummary(selected) };
          return { original: songSummary(original), reimagined: rebuilt.map(songSummary) };
        },
      },
      {
        name: 'list_suno_playlists',
        description: 'List every public Alex Merced Suno playlist with its local page, source URL, artwork, song count and runtime. Use this when a user wants a themed or project-based listening path.',
        inputSchema: { type: 'object', properties: {}, additionalProperties: false },
        execute: async (_input, signal) => {
          const catalog = await getCatalog(signal);
          return { updatedAt: catalog.updatedAt, count: catalog.suno.playlists.length, playlists: catalog.suno.playlists.map(({ trackIds, sourceTracks, ...playlist }) => playlist) };
        },
      },
      {
        name: 'get_suno_playlist',
        description: 'Get one Suno playlist and its ordered track records. Accept a playlist ID, slug or exact name from list_suno_playlists.',
        inputSchema: { type: 'object', properties: { id: { type: 'string', minLength: 1 }, slug: { type: 'string', minLength: 1 }, name: { type: 'string', minLength: 1 } }, additionalProperties: false },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const id = textValue(input, 'id');
          const slug = textValue(input, 'slug').toLowerCase();
          const name = textValue(input, 'name').toLowerCase();
          if (!id && !slug && !name) return { error: 'Provide id, slug, or name.' };
          const playlist = catalog.suno.playlists.find((item) => item.id === id || item.slug === slug || item.name.toLowerCase() === name);
          if (!playlist) return { error: 'No Suno playlist matched.' };
          const bySunoUrl = new Map(catalog.songs.flatMap((song) => song.links.filter((link) => link.source === 'suno').map((link) => [link.url, song])));
          const { sourceTracks, ...playlistSummary } = playlist;
          return { updatedAt: catalog.updatedAt, playlist: playlistSummary, tracks: sourceTracks.map((source) => { const song = bySunoUrl.get(source.url); return song ? { source, catalogSong: songSummary(song) } : { source, catalogSong: null }; }) };
        },
      },
      {
        name: 'get_catalog_updates_since',
        description: 'Poll for songs published since an ISO date. Returns dated catalog records in newest-first order and the current catalog update date.',
        inputSchema: { type: 'object', properties: { since: { type: 'string', minLength: 4, description: 'ISO date or timestamp.' }, kind: { type: 'string', enum: ['all', 'archive', 'electronic', 'reimagined', 'generated'], default: 'all' }, limit: { type: 'integer', minimum: 1, maximum: 100, default: 25 }, offset: { type: 'integer', minimum: 0, default: 0 } }, required: ['since'], additionalProperties: false },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const since = textValue(input, 'since');
          const timestamp = Date.parse(since);
          if (!Number.isFinite(timestamp)) return { error: 'Provide a valid ISO date or timestamp.' };
          const kind = textValue(input, 'kind') || 'all';
          const matches = catalog.songs.filter((song) => song.createdAt && Date.parse(song.createdAt) > timestamp && (kind === 'all' || song.kind === kind)).sort((left, right) => Date.parse(right.createdAt) - Date.parse(left.createdAt));
          return { since, updatedAt: catalog.updatedAt, kind, ...page(matches.map(songSummary), input) };
        },
      },
      {
        name: 'get_suno_prompting_guide',
        description: 'Get the structured Suno prompting guide with prompt architecture, keys, chord progressions, time signatures, percussion, genre and sound palettes, vocals, production, controls, troubleshooting, recipes and evaluation guidance.',
        inputSchema: { type: 'object', properties: {}, additionalProperties: false },
        execute: async (_input, signal) => {
          const catalog = await getCatalog(signal);
          return { updatedAt: catalog.updatedAt, guide: catalog.guides.sunoPrompting };
        },
      },
      {
        name: 'get_suno_prompting_section',
        description: 'Get one focused part of the Suno prompting guide. Omit section to list the available section names. Use this instead of the full guide when the question concerns one musical dimension.',
        inputSchema: {
          type: 'object',
          properties: {
            section: { type: 'string', enum: ['fundamentals', 'genres', 'instruments', 'vocals', 'rhythm', 'harmony', 'arrangement', 'production', 'lyrics', 'hybrids', 'controls', 'troubleshooting', 'recipes', 'vocabulary', 'workflow'] },
          },
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const sections = promptingSections(catalog.guides.sunoPrompting);
          const section = textValue(input, 'section');
          if (!section) return { pageUrl: catalog.guides.sunoPrompting.pageUrl, sections: Object.keys(sections) };
          return { pageUrl: catalog.guides.sunoPrompting.pageUrl, section, content: sections[section] };
        },
      },
      {
        name: 'search_suno_prompting_guide',
        description: 'Search every Suno prompting reference, including keys, chord progressions, time signatures, percussion, genres, instruments, vocals, production, controls, recipes and troubleshooting. Returns matching passages with their section paths.',
        inputSchema: {
          type: 'object',
          properties: {
            query: { type: 'string', minLength: 1, description: 'A key, chord progression, meter, percussion idea, musical problem, genre, instrument, vocal trait or production idea.' },
            limit: { type: 'integer', minimum: 1, maximum: 50, default: 20 },
          },
          required: ['query'],
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const query = textValue(input, 'query').toLowerCase();
          if (!query) return { error: 'Provide a non-empty query.' };
          const matches = searchPromptingValues(promptingSections(catalog.guides.sunoPrompting), query);
          return { query, pageUrl: catalog.guides.sunoPrompting.pageUrl, ...page(matches, input) };
        },
      },
      {
        name: 'compose_suno_prompt',
        description: 'Assemble a focused Suno Style prompt from separate musical choices. This formats the user supplied direction and does not generate music or send data to Suno.',
        inputSchema: {
          type: 'object',
          properties: {
            genre: { type: 'string', minLength: 1 },
            era: { type: 'string' },
            keyHarmony: { type: 'string', description: 'Key, chord progression, harmonic rhythm or modal direction.' },
            tempoGroove: { type: 'string' },
            meterGrouping: { type: 'string', description: 'Time signature, subdivision and accent grouping.' },
            instruments: { oneOf: [{ type: 'string' }, { type: 'array', items: { type: 'string' }, minItems: 1 }], description: 'Three to five defining instruments with roles when possible, as text or a list.' },
            vocal: { type: 'string' },
            arrangement: { type: 'string' },
            production: { oneOf: [{ type: 'string' }, { type: 'array', items: { type: 'string' }, minItems: 1 }] },
            ending: { type: 'string' },
            exclude: { oneOf: [{ type: 'string' }, { type: 'array', items: { type: 'string' }, minItems: 1 }] },
          },
          required: ['genre'],
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const fields = ['genre', 'era', 'keyHarmony', 'tempoGroove', 'meterGrouping', 'instruments', 'vocal', 'arrangement', 'production', 'ending'];
          const clauses = fields.map((key) => promptValue(input, key)).filter(Boolean);
          return {
            stylePrompt: clauses.join(', '),
            exclude: promptValue(input, 'exclude') || null,
            formula: catalog.guides.sunoPrompting.formula,
            guideUrl: catalog.guides.sunoPrompting.pageUrl,
            note: clauses.length < 4 ? 'Add more musical dimensions if you need a more focused result.' : 'Generate multiple candidates and change one dimension at a time.',
          };
        },
      },
      {
        name: 'transpose_chord_progression',
        description: 'Transpose a common functional chord progression into a selected tonic and return exact chord names plus a copyable Suno harmony clause.',
        inputSchema: {
          type: 'object',
          properties: {
            key: { type: 'string', enum: ['C', 'D-flat', 'D', 'E-flat', 'E', 'F', 'F-sharp', 'G', 'A-flat', 'A', 'B-flat', 'B'] },
            progression: { type: 'string', enum: ['I-V-vi-IV', 'vi-IV-I-V', 'I-IV-V-I', 'ii7-V7-Imaj7', 'i-VI-III-VII', 'i-iv-V-i', 'I-flat VII-IV', 'i-IV Dorian vamp'] },
            harmonicRhythm: { type: 'string', default: 'one chord per bar' },
          },
          required: ['key', 'progression'],
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const notes = ['C', 'D-flat', 'D', 'E-flat', 'E', 'F', 'F-sharp', 'G', 'A-flat', 'A', 'B-flat', 'B'];
          const patterns = {
            'I-V-vi-IV': [[0, ''], [7, ''], [9, 'm'], [5, '']],
            'vi-IV-I-V': [[9, 'm'], [5, ''], [0, ''], [7, '']],
            'I-IV-V-I': [[0, ''], [5, ''], [7, ''], [0, '']],
            'ii7-V7-Imaj7': [[2, 'm7'], [7, '7'], [0, 'maj7']],
            'i-VI-III-VII': [[0, 'm'], [8, ''], [3, ''], [10, '']],
            'i-iv-V-i': [[0, 'm'], [5, 'm'], [7, ''], [0, 'm']],
            'I-flat VII-IV': [[0, ''], [10, ''], [5, '']],
            'i-IV Dorian vamp': [[0, 'm'], [5, '']],
          };
          const key = textValue(input, 'key');
          const progression = textValue(input, 'progression');
          const root = notes.indexOf(key);
          const chords = patterns[progression].map(([offset, quality]) => `${notes[(root + offset) % 12]}${quality}`);
          const harmonicRhythm = textValue(input, 'harmonicRhythm') || 'one chord per bar';
          return { key, progression, chords, harmonicRhythm, promptClause: `${key} tonal center, ${progression}, chords ${chords.join('-')}, ${harmonicRhythm}`, guideUrl: catalog.guides.sunoPrompting.pageUrl, note: 'Verify the generated key and chord movement by ear or with an instrument.' };
        },
      },
      {
        name: 'design_meter_prompt',
        description: 'Turn a time signature and additive beat grouping into a clear Suno rhythm clause with an accent map.',
        inputSchema: {
          type: 'object',
          properties: {
            meter: { type: 'string', enum: ['2/4', '3/4', '4/4', '5/4', '5/8', '6/8', '7/4', '7/8', '9/8', '10/8', '11/8', '12/8'] },
            grouping: { type: 'string', minLength: 1, description: 'Additive grouping such as 2+2+3.' },
            bpm: { type: 'integer', minimum: 30, maximum: 300 },
            anchor: { type: 'string', default: 'kick and bass' },
            section: { type: 'string', default: 'verse' },
          },
          required: ['meter', 'grouping'],
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const meter = textValue(input, 'meter');
          const grouping = textValue(input, 'grouping');
          const groups = grouping.split('+').map(Number);
          const numerator = Number(meter.split('/')[0]);
          if (groups.some((value) => !Number.isInteger(value) || value < 1) || groups.reduce((sum, value) => sum + value, 0) !== numerator) return { error: `Grouping must contain positive numbers that add to ${numerator}.` };
          const starts = []; let position = 1;
          groups.forEach((size) => { starts.push(position); position += size; });
          const bpm = input?.bpm ? `${numberValue(input, 'bpm', 100, 30, 300)} BPM, ` : '';
          const anchor = textValue(input, 'anchor') || 'kick and bass';
          const section = textValue(input, 'section') || 'verse';
          return { meter, grouping, accentPositions: starts, promptClause: `${bpm}${meter} grouped ${grouping} in the ${section}, ${anchor} accent each group start, steady subdivision across the full bar`, guideUrl: catalog.guides.sunoPrompting.pageUrl, note: catalog.guides.sunoPrompting.studioMeterNote };
        },
      },
      {
        name: 'diagnose_suno_result',
        description: 'Map a common audible problem in a Suno result to a likely cause and one focused next experiment.',
        inputSchema: { type: 'object', properties: { symptom: { type: 'string', enum: ['chorus does not lift', 'requested key drifts', 'odd meter sounds like 4/4', 'lyrics feel rushed', 'arrangement is crowded', 'drums sound generic', 'ending feels abrupt', 'word is mispronounced'] } }, required: ['symptom'], additionalProperties: false },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const symptom = textValue(input, 'symptom').toLowerCase();
          const match = catalog.guides.sunoPrompting.generationDiagnosis.find(([result]) => result.toLowerCase() === symptom);
          return match ? { symptom: match[0], likelyCause: match[1], nextExperiment: match[2], guideUrl: catalog.guides.sunoPrompting.pageUrl } : { error: 'No diagnosis matched.' };
        },
      },
      {
        name: 'build_arrangement_blueprint',
        description: 'Return a section map, energy plan and copyable prompt for a selected song form.',
        inputSchema: { type: 'object', properties: { form: { type: 'string', enum: ['Focused pop song', 'Progressive mixed-meter song', 'Story-driven folk song', 'Dance build and drop', 'Through-composed art song', 'Concept-album opener', 'Concept-album finale'] } }, required: ['form'], additionalProperties: false },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const form = textValue(input, 'form');
          const blueprint = catalog.guides.sunoPrompting.arrangementBlueprints.find((item) => item.name === form);
          return blueprint ? { blueprint, guideUrl: catalog.guides.sunoPrompting.pageUrl, note: 'Treat bar counts as planning units and adjust the proportions by ear.' } : { error: 'No arrangement blueprint matched.' };
        },
      },
      {
        name: 'create_album_style_bible',
        description: 'Assemble a concise consistency brief for a Suno EP or concept album from the user’s musical rules.',
        inputSchema: {
          type: 'object',
          properties: {
            identity: { type: 'string', minLength: 1 }, harmonicPalette: { type: 'string' }, motif: { type: 'string' }, instruments: { type: 'string' }, vocal: { type: 'string' }, production: { type: 'string' }, trackRoles: { type: 'string' },
          },
          required: ['identity'],
          additionalProperties: false,
        },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const labels = [['identity', 'Core identity'], ['harmonicPalette', 'Harmonic palette'], ['motif', 'Recurring motif'], ['instruments', 'Instrument family'], ['vocal', 'Vocal identity'], ['production', 'Production rules'], ['trackRoles', 'Track roles']];
          const bible = labels.map(([key, label]) => ({ area: label, direction: textValue(input, key) })).filter((item) => item.direction);
          return { styleBible: bible, continuityLogFields: ['prompt', 'model', 'settings', 'key', 'BPM', 'meter', 'voice', 'motif', 'production notes'], guideUrl: catalog.guides.sunoPrompting.pageUrl };
        },
      },
      {
        name: 'list_reimaginings',
        description: 'List every Suno rebuild paired with its exact acoustic source recording and canonical pages. Use this when comparing original and new versions.',
        inputSchema: { type: 'object', properties: {}, additionalProperties: false },
        execute: async (_input, signal) => {
          const catalog = await getCatalog(signal);
          const songsById = new Map(catalog.songs.map((song) => [song.id, song]));
          return { updatedAt: catalog.updatedAt, pairs: catalog.songs.filter((song) => song.kind === 'reimagined').map((rebuilt) => ({ rebuilt: songSummary(rebuilt), original: rebuilt.originalTrackId ? songSummary(songsById.get(rebuilt.originalTrackId)) : null })) };
        },
      },
      {
        name: 'list_albums',
        description: 'List the electronic albums and their canonical pages. Optionally select one album by ID or slug to receive its complete ordered track records.',
        inputSchema: { type: 'object', properties: { id: { type: 'string', minLength: 1 }, slug: { type: 'string', minLength: 1 } }, additionalProperties: false },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const id = textValue(input, 'id');
          const slug = textValue(input, 'slug');
          const selected = id || slug ? catalog.albums.find((album) => album.id === id || album.slug === slug) : null;
          if ((id || slug) && !selected) return { error: 'No album matched.', albums: catalog.albums };
          if (!selected) return { updatedAt: catalog.updatedAt, albums: catalog.albums };
          const songsById = new Map(catalog.songs.map((song) => [song.id, song]));
          return { updatedAt: catalog.updatedAt, album: selected, tracks: selected.trackIds.map((trackId) => songSummary(songsById.get(trackId))) };
        },
      },
      {
        name: 'where_to_listen',
        description: 'List verified music platforms and exact distributed release links. Use this when a user wants a profile, album, playlist, or service rather than a specific song.',
        inputSchema: { type: 'object', properties: { era: { type: 'string', enum: ['all', 'acoustic', 'electronic', 'ai'], default: 'all' } }, additionalProperties: false },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const era = textValue(input, 'era') || 'all';
          return { era, platforms: catalog.platforms.filter((platform) => era === 'all' || platform.era === era || platform.era === 'all'), distributedReleases: catalog.distributedReleases };
        },
      },
      {
        name: 'get_ai_music_perspective',
        description: 'Return Alex Merced’s first-person article about AI, art and music. Use this when a user asks what Alex thinks about AI-assisted creativity, artistic skill, creative access or the effect on working artists.',
        inputSchema: { type: 'object', properties: {}, additionalProperties: false },
        execute: async () => ({
          title: 'When Hard Becomes Easy: AI, Art, and the Question of Worth',
          author: 'Alex Merced',
          publishedAt: '2026-06-26',
          url: 'https://amdatalakehouse.substack.com/p/when-hard-becomes-easy-ai-art-and',
          summary: 'Alex weighs wider creative access and new artistic possibilities against the erosion of foundational skills, creative commission work and compensation frameworks that lag behind the technology.',
        }),
      },
      {
        name: 'navigate_catalog',
        description: 'Get canonical internal URLs for the catalog, artist profile, machine-readable data, albums, and individual songs. Use this to navigate the site or give a user a durable AlexMercedMusic.com link.',
        inputSchema: { type: 'object', properties: { section: { type: 'string', enum: ['all', 'main', 'songs', 'videos', 'albums'], default: 'main' }, limit: { type: 'integer', minimum: 1, maximum: 100, default: 25 }, offset: { type: 'integer', minimum: 0, default: 0 } }, additionalProperties: false },
        execute: async (input, signal) => {
          const catalog = await getCatalog(signal);
          const section = textValue(input, 'section') || 'main';
          const main = [
            { label: 'Home', url: `${catalog.site}/` }, { label: 'Acoustic archive', url: `${catalog.site}/acoustic/` },
            { label: 'Reimagined with Suno', url: `${catalog.site}/reimagined/` }, { label: 'Electronic catalogue', url: `${catalog.site}/electronic/` },
            { label: 'Suno playlists', url: `${catalog.site}/suno/` },
            { label: 'Suno Prompting Field Guide', url: `${catalog.site}/suno-prompting-guide/` },
            { label: 'Where to listen', url: `${catalog.site}/listen/` }, { label: 'About Alex Merced', url: `${catalog.site}/about/` },
            { label: 'Explore every song', url: `${catalog.site}/songs/` }, { label: 'Music videos', url: `${catalog.site}/videos/` }, { label: 'Listening stories', url: `${catalog.site}/stories/` },
            { label: 'WebMCP guide', url: `${catalog.site}/webmcp/` }, { label: 'Machine-readable catalog', url: `${catalog.site}/catalog.json` },
            { label: 'LLM guide', url: `${catalog.site}/llms.txt` }, { label: 'RSS feed', url: `${catalog.site}/feed.xml` }, { label: 'JSON Feed', url: `${catalog.site}/feed.json` },
          ];
          if (section === 'main') return { pages: main };
          if (section === 'songs') return page(catalog.songs.map((song) => ({ id: song.id, title: song.title, url: song.pageUrl })), input);
          if (section === 'videos') return page(catalog.videos.map((video) => ({ id: video.id, title: video.title, url: video.pageUrl })), input);
          if (section === 'albums') return { albums: catalog.albums.map((album) => ({ id: album.id, title: album.title, url: album.pageUrl })) };
          return { pages: main, songs: page(catalog.songs.map((song) => ({ id: song.id, title: song.title, url: song.pageUrl })), input), videos: page(catalog.videos.map((video) => ({ id: video.id, title: video.title, url: video.pageUrl })), input), albums: catalog.albums };
        },
      },
    ];

    const register = async (context) => {
      registrationController?.abort();
      registrationController = new AbortController();
      const options = { signal: registrationController.signal };
      const registrations = await Promise.allSettled(tools.map((tool) => context.registerTool({
        name: tool.name,
        description: tool.description,
        inputSchema: tool.inputSchema,
        annotations,
        execute: async (input, clientContext = {}) => {
          try { return json(await tool.execute(input ?? {}, clientContext.signal)); }
          catch (error) { return json({ error: error instanceof Error ? error.message : String(error) }); }
        },
      }, options)));
      const failures = registrations.filter((result) => result.status === 'rejected');
      if (failures.length) console.warn(`WebMCP: ${failures.length} of ${tools.length} tools failed to register.`, failures);
    };

    window.addEventListener('pagehide', () => registrationController?.abort(), { once: true });
    const context = getContext();
    if (context) { void register(context); return; }

    const started = Date.now();
    const timer = window.setInterval(() => {
      const delayedContext = getContext();
      if (delayedContext) { window.clearInterval(timer); void register(delayedContext); }
      else if (Date.now() - started > WAIT_MS) window.clearInterval(timer);
    }, POLL_MS);
  })();
</script>
