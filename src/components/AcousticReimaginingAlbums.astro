---
import { reimaginedAlbums } from '../data/catalog';

interface Props {
  includeComparison?: boolean;
}

const { includeComparison = true } = Astro.props;
---

<div class="btn-row acoustic-album-ctas">
  {reimaginedAlbums.map((album) => (
    <a class="btn btn--primary" href={album.url}>{album.volume}: originals and reimaginings ↗</a>
  ))}
  {includeComparison && <a class="btn" href="/reimagined/">Compare every version</a>}
</div>

