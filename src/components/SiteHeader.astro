---
export interface Props { path: string }
const { path } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/acoustic', label: 'Acoustic' },
  { href: '/reimagined', label: 'Reimagined' },
  { href: '/electronic', label: 'Electronic' },
  { href: '/listen', label: 'Listen' },
];

const here = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/">Alex Merced<span>.</span>Music</a>
    <nav class="site-nav" aria-label="Sections">
      {links.map((l) => (
        <a href={l.href} aria-current={here(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
