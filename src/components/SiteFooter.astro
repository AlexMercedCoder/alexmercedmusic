---
import { connectLinks, newsletter } from '../data/network';
// Network links and the CTA come from network/network.json, regenerated by
// alexmercedcom/scripts/build-network-shared.mjs. Do not hard-code them here.
import network from '../../network/network.json';
const { footer, cta } = network;
const year = new Date().getFullYear();
---

{cta && (
  <section class="network-cta" aria-label={cta.heading}>
    <div class="shell network-cta__inner">
      <h2 class="network-cta__heading">{cta.heading}</h2>
      <div class="btn-row">
        {cta.links.map((l, i) => (
          <a class={i === 0 ? 'btn btn--primary' : 'btn'} href={l.url} data-network-event={l.event} rel="noopener">{l.label}</a>
        ))}
      </div>
    </div>
  </section>
)}

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div>
        <h4>This site</h4>
        <ul>
          <li><a href="/acoustic">Acoustic archive</a></li>
          <li><a href="/reimagined">Reimagined with Suno</a></li>
          <li><a href="/suno/">Suno playlists</a></li>
          <li><a href="/suno-prompting-guide/">Suno prompting guide</a></li>
          <li><a href="/music-theory/">Music theory guide</a></li>
          <li><a href="/electronic">Electronic catalogue</a></li>
          <li><a href="/listen">Where to listen</a></li>
          <li><a href="/videos/">Music videos</a></li>
          <li><a href="/songs/">Explore every song</a></li>
          <li><a href="/stories/">Listening guides</a></li>
          <li><a href="/about">About Alex</a></li>
          <li><a href="/catalog.json">Machine-readable catalog</a></li>
          <li><a href="/webmcp/">WebMCP tools</a></li>
          <li><a href="/feed.xml">New music RSS</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
        </ul>
      </div>
      {footer.groups.map((group) => (
        <div>
          <h4>{group.title}</h4>
          <ul>
            {group.links.map((l) => <li><a href={l.url}>{l.title}</a></li>)}
            <li><a href={footer.allSitesUrl}>{footer.allSitesLabel}</a></li>
          </ul>
        </div>
      ))}
      <div>
        <h4>Connect</h4>
        <ul>
          {connectLinks.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <p>
        Alex Merced writes and records music, and has done since the mid-2000s. His work in
        data and AI lives across <a href="https://alexmerced.com">the rest of the network</a>,
        and the weekly newsletter is at <a href={newsletter.url}>amdatalakehouse.substack.com</a>.
      </p>
      <p>&copy; {year} Alex Merced. Recordings and songs are his own.</p>
    </div>
  </div>
</footer>
