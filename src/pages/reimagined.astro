---
import Base from '../layouts/Base.astro';
import FeaturedReimaginingAlbums from '../components/FeaturedReimaginingAlbums.astro';
import { acousticTracks, allReimagined, electronicReimagined, electronicTracks, featuredReimaginingAlbums, reimagined, reimaginedPlaylist, sunoSongs, sunoStyle } from '../data/catalog';
import { SITE, songByPrimaryUrl } from '../data/catalog-model';

const originals = new Map([...acousticTracks, ...electronicTracks].map((track) => [`${'sources' in track ? 'electronic' : 'acoustic'}:${track.title}`, track]));
const originalFor = (song: (typeof allReimagined)[number]) => originals.get(`${song.originalEra ?? 'acoustic'}:${song.original}`);
const detailUrl = (url?: string) => url ? songByPrimaryUrl.get(url)?.pageUrl.replace(SITE, '') : undefined;

const albumGroups = [reimagined.slice(0, 10), reimagined.slice(10), electronicReimagined];
const jsonLd = featuredReimaginingAlbums.map((album, albumIndex) => {
  const albumTracks = albumGroups[albumIndex];
  return {
    '@type': 'MusicAlbum',
    '@id': `${album.url}#album`,
    name: album.title,
    url: album.url,
    numTracks: albumTracks.length * 3,
    description: album.description,
    byArtist: { '@id': 'https://alexmercedmusic.com/#musicgroup' },
    track: albumTracks.map((t, i) => ({
      '@type': 'MusicRecording',
      '@id': `${songByPrimaryUrl.get(t.url!)?.pageUrl}#recording`,
      position: i + 1,
      name: t.title,
      url: songByPrimaryUrl.get(t.url!)?.pageUrl,
      sameAs: t.links?.map((link) => link.url),
      byArtist: { '@id': 'https://alexmercedmusic.com/#musicgroup' },
    })),
  };
});
---

<Base
  title="Reimagined with Suno"
  description="Three Suno albums pair 29 original Alex Merced recordings with two reimaginings each, spanning acoustic songs and electronic productions."
  keywords={['Suno', 'AI music', 'AI covers', 'Alex Merced', 'disco house', 'salsa cover']}
  jsonLd={jsonLd}
>
  <section class="section" data-era="ai">
    <div class="shell">
      <p class="eyebrow">Era three</p>
      <h1>The songs, handed to a model</h1>
      <p class="lede">
        These three collections put the source first. Two volumes pair eighteen acoustic
        recordings with new arrangements. The electronic volume does the same for eleven
        tracks Alex produced in FL Studio.
      </p>
      <p class="lede" style="margin-top:1rem">
        Each featured album sequences an original recording followed by two Suno reimaginings.
        Every source and both new versions are linked below. The earlier
        seven-video YouTube series and earlier Suno generations remain available as supporting versions.
      </p>
      <div style="margin-top:1.8rem">
        <FeaturedReimaginingAlbums includeComparison={false} />
        <div class="btn-row" style="margin-top:.8rem">
        <a class="btn" href={reimaginedPlaylist.url}>Watch the earlier video series</a>
        <a class="btn" href="/acoustic">Read the originals</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <h2>What became what</h2>
      </div>
      <div class="grid" style="gap:0.8rem">
        {allReimagined.map((song) => (
          <div class="pair">
            <div class="pair__side pair__then">
              <small>{song.original ? 'The recording' : 'Original not in the archive'}</small>
              <div class="pair__title">
                {song.original && originalFor(song)
                  ? <a class="song-link" href={detailUrl(originalFor(song)?.url)}>{song.original}</a>
                  : song.original ?? 'An earlier song of his'}
              </div>
              {song.original && originalFor(song) ? (
                <div class="source-links">
                  {originalFor(song)?.links?.map((link) => <a href={link.url}>{link.label ?? 'Original'} ↗</a>) ?? <a href={originalFor(song)?.url}>Original ↗</a>}
                </div>
              ) : (
                <div class="pair__style">Original recording unavailable</div>
              )}
            </div>
            <div class="pair__arrow" aria-hidden="true">&rarr;</div>
            <div class="pair__side pair__now">
              <small>Rebuilt as</small>
              <div class="pair__title"><a class="song-link" href={detailUrl(song.url)}>{song.title}</a></div>
              <div class="pair__style">{song.style}{song.length ? ` · ${song.length}` : ''}</div>
              <div class="source-links">
                {song.links?.map((link) => (
                  <a href={link.url}>Rebuilt · {link.label ?? (link.source === 'youtube' ? 'YouTube' : 'Suno')} ↗</a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <h2>And newer songs, written with it</h2>
        <p>
          Beyond these {allReimagined.length} rebuilt songs, Suno currently exposes {sunoSongs.length}
          additional published songs spanning {sunoStyle}.
        </p>
      </div>
      <ol class="tracks">
        {sunoSongs.map((t, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span>{t.url ? <a class="song-link" href={detailUrl(t.url)}>{t.title}</a> : t.title}</span>
            <span class="len"><a class="platform-link" href={t.url}>Suno ↗</a></span>
          </li>
        ))}
      </ol>
      <div class="btn-row" style="margin-top:1.4rem">
        <a class="btn" href="https://suno.com/@alexmerced">The Suno profile</a>
        <a class="btn" href="/suno/">Browse the Suno albums and playlists</a>
      </div>
    </div>
  </section>
</Base>
