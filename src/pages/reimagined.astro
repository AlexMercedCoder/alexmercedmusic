---
import Base from '../layouts/Base.astro';
import { acousticTracks, reimagined, reimaginedAlbum, reimaginedPlaylist, sunoSongs, sunoStyle } from '../data/catalog';
import { SITE, songByPrimaryUrl } from '../data/catalog-model';

const originals = new Map(acousticTracks.map((track) => [track.title, track]));
const detailUrl = (url?: string) => url ? songByPrimaryUrl.get(url)?.pageUrl.replace(SITE, '') : undefined;

const jsonLd = [
  {
    '@type': 'MusicPlaylist',
    '@id': 'https://alexmercedmusic.com/reimagined/#playlist',
    name: reimaginedAlbum.title,
    url: reimaginedAlbum.url,
    numTracks: reimagined.length,
    description: reimaginedAlbum.description,
    byArtist: { '@id': 'https://alexmercedmusic.com/#musicgroup' },
    track: reimagined.map((t, i) => ({
      '@type': 'MusicRecording',
      '@id': `${songByPrimaryUrl.get(t.url!)?.pageUrl}#recording`,
      position: i + 1,
      name: t.title,
      url: songByPrimaryUrl.get(t.url!)?.pageUrl,
      sameAs: t.links?.map((link) => link.url),
      byArtist: { '@id': 'https://alexmercedmusic.com/#musicgroup' },
    })),
  },
];
---

<Base
  title="Reimagined with Suno"
  description="Ten acoustic songs by Alex Merced, each paired with its original recording and two AI reimaginations from the canonical Suno album."
  keywords={['Suno', 'AI music', 'AI covers', 'Alex Merced', 'disco house', 'salsa cover']}
  jsonLd={jsonLd}
>
  <section class="section" data-era="ai">
    <div class="shell">
      <p class="eyebrow">Era three</p>
      <h1>The songs, handed to a model</h1>
      <p class="lede">
        A song written for one voice and one guitar carries arrangements it never got
        to have. This collection pairs ten archive recordings with two AI reimaginations
        of each song.
      </p>
      <p class="lede" style="margin-top:1rem">
        <a href={reimaginedAlbum.url}>{reimaginedAlbum.title}</a> is the canonical collection.
        Its original recordings and both new versions are linked below. The earlier
        seven-video YouTube series and earlier Suno generations remain available as supporting versions.
      </p>
      <div class="btn-row" style="margin-top:1.8rem">
        <a class="btn btn--primary" href={reimaginedAlbum.url}>Play the canonical album ↗</a>
        <a class="btn" href={reimaginedPlaylist.url}>Watch the earlier video series</a>
        <a class="btn" href="/acoustic">Read the originals</a>
      </div>
    </div>
  </section>

  <section class="section" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <h2>What became what</h2>
      </div>
      <div class="grid" style="gap:0.8rem">
        {reimagined.map((song) => (
          <div class="pair">
            <div class="pair__side pair__then">
              <small>{song.original ? 'The recording' : 'Original not in the archive'}</small>
              <div class="pair__title">
                {song.original && originals.get(song.original)
                  ? <a class="song-link" href={detailUrl(originals.get(song.original)?.url)}>{song.original}</a>
                  : song.original ?? 'An earlier song of his'}
              </div>
              {song.original && originals.get(song.original) ? (
                <div class="source-links">
                  {originals.get(song.original)?.links?.map((link) => <a href={link.url}>{link.label ?? 'Original'} ↗</a>) ?? <a href={originals.get(song.original)?.url}>Original ↗</a>}
                </div>
              ) : (
                <div class="pair__style">Original recording unavailable</div>
              )}
            </div>
            <div class="pair__arrow" aria-hidden="true">&rarr;</div>
            <div class="pair__side pair__now">
              <small>Rebuilt as</small>
              <div class="pair__title"><a class="song-link" href={detailUrl(song.url)}>{song.title}</a></div>
              <div class="pair__style">{song.style}{song.length ? ` · ${song.length}` : ''}</div>
              <div class="source-links">
                {song.links?.map((link) => (
                  <a href={link.url}>Rebuilt · {link.label ?? (link.source === 'youtube' ? 'YouTube' : 'Suno')} ↗</a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <h2>And newer songs, written with it</h2>
        <p>
          Beyond these {reimagined.length} archive songs, Suno currently exposes {sunoSongs.length}
          additional published songs spanning {sunoStyle}.
        </p>
      </div>
      <ol class="tracks">
        {sunoSongs.map((t, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span>{t.url ? <a class="song-link" href={detailUrl(t.url)}>{t.title}</a> : t.title}</span>
            <span class="len"><a class="platform-link" href={t.url}>Suno ↗</a></span>
          </li>
        ))}
      </ol>
      <div class="btn-row" style="margin-top:1.4rem">
        <a class="btn" href="https://suno.com/@alexmerced">The Suno profile</a>
        <a class="btn" href="/suno/">Browse the Suno albums and playlists</a>
      </div>
    </div>
  </section>
</Base>
