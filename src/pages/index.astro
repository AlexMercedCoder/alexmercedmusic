---
import Base from '../layouts/Base.astro';
import PlatformMark from '../components/PlatformMark.astro';
import FeaturedReimaginingAlbums from '../components/FeaturedReimaginingAlbums.astro';
import {
  acousticTracks, acousticPlaylist, allReimagined, featuredReimaginingAlbums, reimaginedPlaylist,
  albums, distributedReleases, electronicStats, electronicRuntime, electronicTracks, sunoAlbums, sunoSongs, sunoPublishedCount, sunoPlaylists, platforms,
} from '../data/catalog';
import { SITE, songByPrimaryUrl, videos } from '../data/catalog-model';

const paired = allReimagined;
const originals = new Map([...acousticTracks, ...electronicTracks].map((track) => [`${'sources' in track ? 'electronic' : 'acoustic'}:${track.title}`, track]));
const originalFor = (song: (typeof allReimagined)[number]) => originals.get(`${song.originalEra ?? 'acoustic'}:${song.original}`);
const detailUrl = (url?: string) => url ? songByPrimaryUrl.get(url)?.pageUrl.replace(SITE, '') : undefined;
const recentSuno = sunoSongs.slice(0, 6);
const featuredPlaylists = [...sunoAlbums, ...sunoPlaylists.filter((playlist) => playlist.collectionType === 'album')];
const recentVideos = videos.slice(0, 3);
const distributedAlbum = distributedReleases.find((release) => release.title === 'Songs for your Consideration');
const homepagePlatforms = (distributedAlbum?.links ?? []).map((link) => ({
  ...link,
  url: link.label === 'Spotify' ? 'https://open.spotify.com/artist/7saFKAusZMQg0PnHcO8zm6' : link.url,
}));

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': 'https://alexmercedmusic.com/#homepage',
    url: 'https://alexmercedmusic.com/',
    name: 'Alex Merced Music',
    isPartOf: { '@id': 'https://alexmercedmusic.com/#website' },
    about: { '@id': 'https://alexmercedmusic.com/#musicgroup' },
  },
];
---

<Base
  title="Alex Merced Music"
  description={`Two decades of music by Alex Merced: ${acousticTracks.length} accessible archive recordings, ${electronicStats.total} produced tracks, and ${allReimagined.length} songs rebuilt with Suno.`}
  keywords={['Alex Merced', 'Alex Merced music', 'singer songwriter', 'acoustic', 'glitch hop', 'FL Studio', 'Suno', 'AI covers']}
  jsonLd={jsonLd}
>
  <section class="section hero">
    <div class="shell">
      <div class="hero-album-lead">
        <p class="eyebrow">Originals and reimaginings</p>
        <div class="hero-albums" aria-label="Featured originals and reimaginings albums">
          {featuredReimaginingAlbums.map((album) => (
            <a class="hero-album" href={album.url} aria-label={`Listen to ${album.title} on Suno`}>
              {album.imageUrl && <img src={album.imageUrl} width="640" height="640" loading="eager" decoding="async" alt={`Cover of ${album.title}`} />}
              <span><small>{album.volume}</small>{album.title}</span>
            </a>
          ))}
        </div>
        <p class="hero-album-lead__hint">Choose an album to hear each original recording beside two Suno reimaginings.</p>
      </div>

      <div class="hero__copy">
        <p class="eyebrow">Songs, recordings and productions</p>
        <h1>The same songs,<br />twenty years apart.</h1>
        <p class="lede">
          Alex Merced has been writing and recording since the mid-2000s: a guitar and a
          camera first, then years of electronic production, and lately a set of those
          early songs rebuilt with an AI model. This is where all three live.
        </p>
        <div class="era-key">
          <span data-era="acoustic"><i></i>Acoustic</span>
          <span data-era="electronic"><i></i>Electronic</span>
          <span data-era="ai"><i></i>Rebuilt with Suno</span>
        </div>
        <div style="margin-top:1.6rem">
          <a class="btn btn--primary" href="/reimagined/">Compare every original and reimagining</a>
          <div class="btn-row" style="margin-top:.8rem">
            <a class="btn" href="/songs/">Explore every song</a>
            <a class="btn" href="/videos/">Browse music videos</a>
          </div>
        </div>
        <nav class="streaming-links" aria-label="Listen on streaming platforms">
          <p>Listen on</p>
          <div>
            {homepagePlatforms.map((platform) => (
              <a href={platform.url} aria-label={`Listen to Alex Merced on ${platform.label}`} title={platform.label}>
                <PlatformMark platform={platform.label} />
                <span>{platform.label}</span>
              </a>
            ))}
          </div>
        </nav>
      </div>

      <div class="stats" style="margin-top:2.5rem">
        <div data-era="acoustic"><b>{acousticTracks.length}</b><span>Acoustic recordings</span></div>
        <div data-era="electronic"><b>{electronicStats.total}</b><span>Electronic tracks</span></div>
        <div data-era="ai"><b>{sunoPublishedCount}</b><span>Public Suno generations</span></div>
        <div data-era="electronic"><b>{videos.length}</b><span>Music videos</span></div>
        <div data-era="all"><b>20</b><span>Years of it</span></div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Learn and create</p>
        <h2>Practical guides for writing and producing music</h2>
        <p>Use the theory guide with a guitar, keyboard, MIDI controller or DAW. Use the prompting guide when you want to apply musical decisions inside Suno.</p>
      </div>
      <div class="grid grid--2">
        <article class="card">
          <h3><a href="/music-theory/">Music Theory for Songwriters and Producers</a></h3>
          <p>Explore scales, modes, chord formulas, Roman-numeral progressions, borrowed harmony, melody choices and mood tendencies with interactive tools.</p>
          <p><a href="/music-theory/">Open the standalone theory guide</a></p>
        </article>
        <article class="card">
          <h3><a href="/suno-prompting-guide/">Suno Prompting Field Guide</a></h3>
          <p>Turn musical intent into focused prompts with practical guidance for arrangement, rhythm, harmony, vocals, production and revision.</p>
          <p><a href="/suno-prompting-guide/">Open the Suno guide</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section__head"><p class="eyebrow">Watch and connect</p><h2>Music videos with the full story attached</h2><p>Each video page links to the matching song record, its listening sources and other known versions.</p></div>
      <div class="grid grid--3">
        {recentVideos.map((video) => <article class="card"><img class="video-thumb" src={video.imageUrl} width="480" height="270" loading="lazy" alt={`Video thumbnail for ${video.title}`} /><h3><a href={video.pageUrl.replace(SITE, '')}>{video.title}</a></h3><p>{video.relatedSongIds.length ? `${video.relatedSongIds.length} connected song record${video.relatedSongIds.length === 1 ? '' : 's'}` : 'Channel video'}</p><div class="source-links"><a href={video.pageUrl.replace(SITE, '')}>Details</a><a href={video.watchUrl}>YouTube ↗</a></div></article>)}
      </div>
      <div class="btn-row" style="margin-top:1.5rem"><a class="btn btn--primary" href="/videos/">Browse all {videos.length} videos</a></div>
    </div>
  </section>

  <section class="section" id="originals-and-reimaginings">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">The loop closed</p>
        <h2>Original recordings beside their Suno reimaginings</h2>
        <p class="lede">
          Three featured Suno albums keep each source recording beside two new versions:
          two volumes from the acoustic archive and a new collection of eleven electronic
          productions made in FL Studio.
        </p>
      </div>

      <FeaturedReimaginingAlbums />

      <div class="grid" style="gap:0.8rem; margin-top:2rem">
        {paired.map((song) => (
          <div class="pair">
            <div class="pair__side pair__then">
              <small>{song.original ? 'The recording' : 'Original not in the archive'}</small>
              <div class="pair__title">
                {song.original && originalFor(song)
                  ? <a class="song-link" href={detailUrl(originalFor(song)?.url)}>{song.original}</a>
                  : song.original ?? 'An earlier song of his'}
              </div>
              {song.original && originalFor(song) ? (
                <div class="source-links">
                  {originalFor(song)?.links?.map((link) => <a href={link.url}>{link.label ?? 'Original'} ↗</a>) ?? <a href={originalFor(song)?.url}>Original ↗</a>}
                </div>
              ) : (
                <div class="pair__style">Original recording unavailable</div>
              )}
            </div>
            <div class="pair__arrow" aria-hidden="true">&rarr;</div>
            <div class="pair__side pair__now">
              <small>Rebuilt as</small>
              <div class="pair__title"><a class="song-link" href={detailUrl(song.url)}>{song.title}</a></div>
              <div class="pair__style">{song.style}{song.length ? ` · ${song.length}` : ''}</div>
              <div class="source-links">
                {song.links?.map((link) => (
                  <a href={link.url}>Rebuilt · {link.label ?? (link.source === 'youtube' ? 'YouTube' : 'Suno')} ↗</a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="btn-row" style="margin-top:.8rem"><a class="btn" href={reimaginedPlaylist.url}>Watch the earlier video series</a></div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Three eras</p>
        <h2>What is here</h2>
      </div>
      <div class="grid grid--3">
        <article class="card card--era" data-era="acoustic">
          <h3>The acoustic archive</h3>
          <p>
            {acousticTracks.length} recordings going back to the mid-2000s, most of
            them posted to his YouTube channel. A guitar, a room, and songs
            about the things you write songs about at that age.
          </p>
          <p><a href="/acoustic">Browse the archive</a></p>
        </article>
        <article class="card card--era" data-era="electronic">
          <h3>The electronic catalogue</h3>
          <p>
            {electronicStats.total} tracks produced in FL Studio, {electronicRuntime} of it,
            filed under electronica, electro pop and glitch hop out of Brooklyn. It is
            scattered over ReverbNation, two SoundCloud accounts and YouTube, so the
            full list is assembled here.
          </p>
          <p><a href="/electronic">Browse all {electronicStats.total}</a></p>
        </article>
        <article class="card card--era" data-era="ai">
          <h3>What he does now</h3>
          <p>
            The day job is data and AI, so the music comes in bursts: {sunoSongs.length} newer songs
            generated on Suno, tagged indie prog, and the occasional acoustic take when a
            guitar is within reach.
          </p>
          <p><a href="/songs/?kind=generated">Browse all generated songs</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" data-era="ai">
    <div class="shell">
      <div class="section__head"><p class="eyebrow">Recently published</p><h2>Latest Suno songs</h2><p>Open the local details, published lyrics and direct Suno source for the newest catalog entries.</p></div>
      <div class="grid grid--3">
        {recentSuno.map((song) => (
          <article class="card card--era" data-era="ai">
            {song.imageUrl && <img class="release-art" src={song.imageUrl} width="320" height="320" loading="lazy" alt={`Artwork for ${song.title}`} />}
            <h3><a href={detailUrl(song.url)}>{song.title}</a></h3>
            <p>{song.genres?.slice(0, 3).join(' · ') || 'Suno generation'}</p>
            <div class="source-links"><a href={detailUrl(song.url)}>Details</a><a href={song.url}>Suno ↗</a></div>
          </article>
        ))}
      </div>
      <div class="btn-row" style="margin-top:1.5rem"><a class="btn btn--primary" href="/songs/?kind=generated">All generated songs</a><a class="btn" href="/suno/">Browse Suno albums and playlists</a></div>
    </div>
  </section>

  <section class="section" data-era="ai">
    <div class="shell">
      <div class="section__head"><p class="eyebrow">Album-length projects</p><h2>Focused Suno albums</h2><p>{featuredPlaylists.length} sequences explore connected ideas and moods rather than presenting a loose list of singles.</p></div>
      <div class="grid grid--3">
        {featuredPlaylists.map((playlist) => <article class="card card--era" data-era="ai"><h3><a href={playlist.pageUrl}>{playlist.name}</a></h3><p>{playlist.description}</p><p>{playlist.songCount} songs</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell">
      <div class="section__head" style="margin-bottom:1.5rem">
        <p class="eyebrow">Everywhere else</p>
        <h2>Where to listen</h2>
      </div>
      <div class="grid grid--2">
        {platforms.slice(0, 4).map((p) => (
          <a class="card card--era" data-era={p.era} href={p.url} style="text-decoration:none">
            <h3>{p.label}</h3>
            <p>{p.note}</p>
            {p.stat && <p class="pair__style">{p.stat}</p>}
          </a>
        ))}
      </div>
      <div class="btn-row" style="margin-top:1.4rem">
        <a class="btn" href="/listen">Every platform</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .video-thumb{width:100%;aspect-ratio:16/9;object-fit:cover;border:1px solid var(--rule);border-radius:var(--radius)}
  .streaming-links{margin-top:1.6rem;padding-top:1.2rem;border-top:1px solid var(--rule)}
  .streaming-links>p{margin:0 0 .65rem;font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .streaming-links>div{display:flex;flex-wrap:wrap;gap:.55rem}
  .streaming-links a{display:flex;align-items:center;gap:.45rem;min-height:3rem;padding:.42rem .7rem;border:1px solid var(--rule);border-radius:999px;background:var(--paper);text-decoration:none;transition:border-color .15s ease,transform .15s ease}
  .streaming-links a:hover{border-color:var(--ink);transform:translateY(-2px)}
  .streaming-links a span{font-size:.78rem;color:var(--ink)}
  @media(max-width:620px){.streaming-links a{width:3rem;padding:.42rem;justify-content:center}.streaming-links a span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}}
</style>
