---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SunoPromptWorkbench from '../components/SunoPromptWorkbench.astro';
import { sunoPromptingGuide as guide } from '../data/suno-prompting-guide';
import { SITE } from '../data/catalog-model';

const faqs = [
  {
    question: 'How should a Suno style prompt be structured?',
    answer: 'Start with one dominant genre, then add era, tempo or groove, defining instruments, vocal character, arrangement, production and an intentional ending.',
  },
  {
    question: 'Where should musical directions and lyrics go?',
    answer: 'Put global musical direction in Style. Put singable text and restrained section cues in Lyrics. Put unwanted instruments and traits in Exclude.',
  },
  {
    question: 'How can an artist reference be made prompt-safe?',
    answer: 'Translate the reference into audible traits such as genre, era, rhythm, instrumentation, vocal delivery, arrangement and production. Do not ask for direct imitation.',
  },
  {
    question: 'What is the best way to improve a weak generation?',
    answer: 'Identify the failing prompt layer, change one or two clauses, generate multiple candidates and compare the same criteria each time.',
  },
  {
    question: 'How do I direct drums in Suno lyrics?',
    answer: 'Put the overall groove and drum sound in Style. Use documented section markers in Lyrics, and test a short bracketed drum cue only for a local change. Bracketed percussion directions are suggestions, not exact sequencing commands.',
  },
  {
    question: 'What do parentheses do in Suno lyrics?',
    answer: 'Suno does not document parentheses as exact command syntax. In practice, short singable text in parentheses can suggest an echo, backing response, ad-lib, wordless hook or rhythmic vocal cell. Spell and group the syllables visibly, then verify the result by ear.',
  },
  {
    question: 'How should I specify a key and chord progression?',
    answer: 'Name the key, Roman-numeral progression, chord qualities and harmonic rhythm. Add exact chord names when pitch matters, then verify the result by ear because prompt details remain probabilistic.',
  },
  {
    question: 'How should I prompt an odd time signature?',
    answer: 'Name the meter, beat grouping, accent pattern and section. For example: 7/8 grouped 2+2+3, with kick accents at each group start in the verse, resolving to 4/4 in the chorus.',
  },
  {
    question: 'What makes a subgenre prompt more specific?',
    answer: 'Name the subgenre, its rhythmic fingerprint, a signature instrument or timbre, the vocal role and one section contrast. For example, tech house with a dry four-on-the-floor kick, mono bass, syncopated conga details and a one-bar break.',
  },
  {
    question: 'When should I stop rewriting the prompt and edit the song instead?',
    answer: 'Edit when the song identity works and the failure is local. Use Replace Section for one passage, Extend for form or ending problems, stems for balance and processing, and MIDI or uploaded audio when notes or timing must be exact.',
  },
  {
    question: 'How can several Suno songs sound like one album?',
    answer: 'Create a style bible covering harmonic palette, recurring motif, instrument family, vocal identity and production rules. Give each track a different narrative role while preserving a few shared decisions.',
  },
];

const jsonLd = [
  {
    '@type': 'TechArticle',
    '@id': `${SITE}/suno-prompting-guide/#article`,
    headline: guide.title,
    description: guide.description,
    url: guide.pageUrl,
    datePublished: '2026-09-13',
    dateModified: '2026-10-07',
    author: { '@id': 'https://alexmerced.com/#alexmerced' },
    publisher: { '@id': 'https://alexmerced.com/#alexmerced' },
    about: ['Suno', 'music prompting', 'keys', 'chord progressions', 'time signatures', 'parentheses in lyrics', 'vocal rhythm', 'percussion', 'song arrangement', 'music production'],
    proficiencyLevel: 'Beginner to advanced',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: guide.title, item: guide.pageUrl },
    ],
  },
];
---

<Base
  title="Suno Prompting Field Guide"
  description={guide.description}
  keywords={['Suno prompting guide', 'Suno prompts', 'Suno parentheses lyrics', 'Suno rhythmic lyrics', 'Suno chord progression prompts', 'Suno time signatures', 'Suno percussion prompts', 'music prompting', 'Suno v6']}
  jsonLd={jsonLd}
  ogType="article"
  dateModified="2026-10-07"
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Suno Prompting Field Guide' }]} />

  <section class="section guide-hero" data-era="ai">
    <div class="shell">
      <p class="eyebrow">Practical music direction</p>
      <h1>Write prompts that describe sound</h1>
      <p class="lede">Use genre, rhythm, instruments, voice, arrangement and production to tell Suno what the listener should hear. Treat every term as musical direction, not a guaranteed command.</p>
      <div class="guide-meta">
        <span>{guide.edition}</span>
        <span>{guide.scope}</span>
        <span>Research verified October 7, 2026</span>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="#prompt-architecture">Build a prompt</a>
        <a class="btn" href="#genre-atlas">Browse the sound palette</a>
        <a class="btn" href="/suno/">Browse Alex’s Suno catalog</a>
        <a class="btn" href="/music-theory/">Study music theory</a>
      </div>
    </div>
  </section>

  <nav class="guide-nav" aria-label="Guide sections">
    <div class="shell">
      <a href="#mental-model">Mental model</a>
      <a href="#workbench">Workbench</a>
      <a href="#prompt-architecture">Prompt architecture</a>
      <a href="#genre-atlas">Genres</a>
      <a href="#harmony">Keys and chords</a>
      <a href="#meter">Time signatures</a>
      <a href="#percussion">Drums and percussion</a>
      <a href="#sound-design">Sound design</a>
      <a href="#melody-vocals">Melody and vocals</a>
      <a href="#arrangement">Arrangement</a>
      <a href="#lyrics">Lyrics</a>
      <a href="#parenthetical-rhythm">Parentheses</a>
      <a href="#lyric-notation">Lyric notation</a>
      <a href="#hybrids">Hybrids</a>
      <a href="#controls">Controls</a>
      <a href="#workflow">Workflow</a>
      <a href="#troubleshooting">Troubleshooting</a>
      <a href="#recipes">Recipes</a>
      <a href="#project-bible">Project planning</a>
      <a href="#checklist">Checklist</a>
    </div>
  </nav>

  <section class="section section--tight" id="mental-model" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">The mental model</p>
        <h2>Describe audible behavior</h2>
        <p>Suno interprets a prompt as a set of musical associations. A focused prompt establishes a clear identity while leaving room for performance and arrangement choices.</p>
      </div>
      <div class="grid grid--3 layer-grid">
        {guide.layers.map((layer, index) => (
          <article class="card card--era" data-era="ai">
            <p class="layer-number">0{index + 1}</p>
            <h3>{layer.name}</h3>
            <p><strong>{layer.question}</strong></p>
            <p>{layer.examples}</p>
          </article>
        ))}
      </div>
      <aside class="principle">
        <strong>Use concrete language.</strong>
        <span>Replace “epic” with “rising strings, massed drums, choir and a final key change.” Replace “innovative” with the musical event you want to hear.</span>
      </aside>
    </div>
  </section>

  <section class="section section--tight" id="workbench" data-era="ai">
    <div class="shell">
      <SunoPromptWorkbench />
    </div>
  </section>

  <section class="section section--tight" id="prompt-architecture" data-era="ai">
    <div class="shell guide-split">
      <div>
        <p class="eyebrow">Prompt architecture</p>
        <h2>Give each clause one job</h2>
        <p class="lede">Six to ten meaningful clauses are a strong default. Start with identity, move through performance, then finish with recording character and the ending.</p>
        <div class="formula" aria-label="Prompt formula">{guide.formula}</div>
      </div>
      <div class="prompt-card">
        <p class="eyebrow">Focused example</p>
        <p>{guide.example}</p>
      </div>
    </div>
    <div class="shell field-grid">
      {guide.fieldGuidance.map((item) => (
        <article>
          <h3>{item.field}</h3>
          <p>{item.use}</p>
        </article>
      ))}
    </div>
    <div class="shell density-grid">
      {guide.promptDensity.map((item) => (
        <article>
          <h3>{item.level}</h3>
          <p><strong>Use:</strong> {item.use}</p>
          <p><strong>Result:</strong> {item.result}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--tight" id="genre-atlas" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Genre atlas</p>
        <h2>Choose a musical neighborhood</h2>
        <p>A genre term carries rhythm, instrumentation, harmony, vocal behavior and production history. Start with one primary genre. Add a second only when it has a clear role.</p>
      </div>
      <div class="atlas-grid">
        {guide.genreFamilies.map((family) => (
          <article class="reference-card">
            <h3>{family.name}</h3>
            <dl>
              {family.terms.map(([term, effect]) => <><dt>{term}</dt><dd>{effect}</dd></>)}
            </dl>
          </article>
        ))}
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">From label to sound</p>
        <h2>Build a subgenre prompt in five moves</h2>
        <p>A style label is a starting point. Add the audible details that distinguish its branches. Afrobeat and Afrobeats, for example, are different traditions; describe the intended groove rather than treating the terms as interchangeable.</p>
      </div>
      <div class="vocab-grid">
        {guide.genreMethod.map((step) => <article><h3>{step.name}</h3><p><strong>Try:</strong> {step.example}</p><p>{step.reason}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="harmony" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Keys and chord progressions</p>
        <h2>Describe tonal home, movement and timing</h2>
        <p>A key names the tonal center. A progression describes how chords move around it. Roman numerals preserve the same harmonic function in any key, while exact chord names identify the pitches you want. Add harmonic rhythm so Suno also knows how quickly the chords should change.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Concept</th><th>Practical direction</th></tr></thead>
          <tbody>{guide.keyGuidance.map(([name, direction]) => <tr><th scope="row">{name}</th><td>{direction}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Progression library</p>
        <h2>State function, pitches and musical effect</h2>
        <p>These progressions are starting points. The same chords can feel different when the tonic, rhythm, voicing, melody or bass line changes.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Roman numerals</th><th>Example</th><th>Likely effect</th></tr></thead>
          <tbody>{guide.chordProgressions.map(([numerals, example, effect]) => <tr><th scope="row">{numerals}</th><td>{example}</td><td>{effect}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Harmonic control</p>
        <h2>Choose the lever that solves the problem</h2>
      </div>
      <div class="vocab-grid">
        {guide.harmonicLevers.map(([name, use]) => <article><h3>{name}</h3><p>{use}</p></article>)}
      </div>
      <aside class="principle">
        <strong>Copyable example</strong>
        <span>D minor, i-VI-III-VII progression, one chord per bar, close piano voicings over a held D pedal, minor iv before the final chorus, then an authentic cadence into the last tonic.</span>
      </aside>
      <div class="section__head subsection-head">
        <p class="eyebrow">When harmony misses</p>
        <h2>Make one harmonic instruction more explicit</h2>
      </div>
      <div class="trouble-list">
        {guide.harmonyTroubleshooting.map(([symptom, revision]) => <article><h3>{symptom}</h3><p>{revision}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="meter" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Time signatures and beat grouping</p>
        <h2>Tell the listener where each cycle leans</h2>
        <p>The fraction alone is often incomplete direction. Add the grouping, accents, subdivision, tempo and instrument that carries the pattern. “7/8 grouped 2+2+3 with bass and kick accents at each group start” gives a clearer rhythmic target than “odd meter.”</p>
      </div>
      <div class="reference-columns">
        <article class="reference-card">
          <h3>Meter palette</h3>
          <dl>{guide.meters.map(([term, effect]) => <><dt>{term}</dt><dd>{effect}</dd></>)}</dl>
        </article>
        <article class="reference-card">
          <h3>Writing method</h3>
          <dl>{guide.meterGuidance.map(([term, effect]) => <><dt>{term}</dt><dd>{effect}</dd></>)}</dl>
        </article>
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Odd-meter drum maps</p>
        <h2>Assign accents to audible instruments</h2>
      </div>
      <div class="atlas-grid">
        {guide.oddMeterPercussion.map(([meter, pattern]) => <article class="reference-card"><h3>{meter}</h3><p>{pattern}</p></article>)}
      </div>
      <aside class="evidence-card subsection-head">
        <p class="eyebrow">Studio limitation</p>
        <h3>The grid and the generation model are separate.</h3>
        <p>{guide.studioMeterNote}</p>
      </aside>
    </div>
  </section>

  <section class="section section--tight" id="percussion" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Percussion control</p>
        <h2>Write the groove as relationships</h2>
        <p>Give the Style field a rhythmic fingerprint: tempo, meter and grouping, kick and snare placement, subdivisions, accent map, touch, percussion color, bass relationship, section changes and drum sound. “Punchy drums” leaves far more to chance than “dry kick on every quarter note, clap on two and four, offbeat open hat, short bass notes between kicks.” Suno recommends naming beat instruments directly in concise prompts.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Dimension</th><th>What to describe</th><th>Copyable phrase</th></tr></thead>
          <tbody>{guide.percussionDimensions.map(([name, meaning, phrase]) => <tr><th scope="row">{name}</th><td>{meaning}</td><td>{phrase}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Genre fingerprints</p>
        <h2>Choose a pattern, then customize it</h2>
        <p>These are descriptive starting points, not fixed rules for each tradition or promises of note-accurate output. Preserve the chosen style’s core pulse before changing the drum kit, bass role or arrangement.</p>
      </div>
      <div class="atlas-grid">
        {guide.percussionRecipes.map(([genre, direction]) => <article class="reference-card"><h3>{genre}</h3><p>{direction}</p></article>)}
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Style field example</p>
        <h2>Describe the whole rhythmic arc</h2>
      </div>
      <div class="prompt-card"><p>{guide.percussionStyleExample}</p></div>
      <div class="section__head subsection-head">
        <p class="eyebrow">When the groove misses</p>
        <h2>Repair one drum relationship at a time</h2>
      </div>
      <div class="trouble-list">
        {guide.percussionTroubleshooting.map(([symptom, revision]) => <article><h3>{symptom}</h3><p>{revision}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="sound-design" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Instrumentation and voice</p>
        <h2>Give every sound a job</h2>
        <p>Use the pattern instrument + role + articulation + processing. “Baritone guitar, foreground rhythm role, palm-muted syncopation, dry overdrive” gives more direction than “guitar.”</p>
      </div>
      <div class="atlas-grid">
        {guide.instrumentFamilies.map((family) => (
          <article class="reference-card">
            <h3>{family.name}</h3>
            <dl>
              {family.items.map(([instrument, character, direction]) => <><dt>{instrument}</dt><dd>{character}. Try {direction}.</dd></>)}
            </dl>
          </article>
        ))}
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Vocal design</p>
        <h2>Separate identity from performance</h2>
        <p>Build a voice from range, weight and texture, then describe how it performs and how close it feels to the listener.</p>
      </div>
      <div class="vocab-grid">
        {guide.vocalDimensions.map((item) => <article><h3>{item.name}</h3><p>{item.examples}</p></article>)}
      </div>
      <aside class="principle">
        <strong>Example voice</strong>
        <span>Mature nasal midrange baritone, exaggerated theatrical diction, fast patter, lo-fi AM radio filter, shellac crackle, narrow bandwidth and light megaphone distortion.</span>
      </aside>
    </div>
  </section>

  <section class="section section--tight" id="melody-vocals" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Melody and vocal writing</p>
        <h2>Write for range, breath and intelligibility</h2>
        <p>A useful vocal prompt separates the melody’s shape from the singer’s identity. Describe contour, comfortable register, phrase length, syllable density and where the performance expands. Treat pronunciation as a local problem that can be tested and replaced.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Dimension</th><th>Working method</th></tr></thead>
          <tbody>{guide.melodyAndVocalWriting.map(([dimension, method]) => <tr><th scope="row">{dimension}</th><td>{method}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Copyable vocal patterns</p>
        <h2>Describe what changes between sections</h2>
      </div>
      <div class="atlas-grid">
        {guide.vocalPromptPatterns.map(([name, pattern]) => <article class="reference-card"><h3>{name}</h3><p>{pattern}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="arrangement" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Rhythm, harmony and form</p>
        <h2>Describe motion over time</h2>
        <p>Tempo gives speed, groove gives placement, and meter gives the recurring beat framework. Harmony sets color. Arrangement gives the song a destination.</p>
      </div>
      <div class="reference-columns">
        <article class="reference-card">
          <h3>Groove</h3>
          <dl>{guide.rhythmTerms.map(([term, effect]) => <><dt>{term}</dt><dd>{effect}</dd></>)}</dl>
        </article>
        <article class="reference-card">
          <h3>Meter</h3>
          <p>The dedicated time-signature section covers simple, compound, additive and alternating meters with accent maps.</p>
          <p><a href="#meter">Explore time signatures and beat grouping</a></p>
        </article>
        <article class="reference-card">
          <h3>Harmony</h3>
          <dl>{guide.harmonyTerms.map(([term, effect]) => <><dt>{term}</dt><dd>{effect}</dd></>)}</dl>
          <p><a href="#harmony">Explore keys and chord progressions</a></p>
        </article>
        <article class="reference-card">
          <h3>Melody</h3>
          <dl>{guide.melodicTerms.map(([term, effect]) => <><dt>{term}</dt><dd>{effect}</dd></>)}</dl>
        </article>
      </div>
      <div class="pattern-strip">
        {guide.arrangementPatterns.map(([name, method]) => <article><h3>{name}</h3><p>{method}</p></article>)}
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Arrangement blueprints</p>
        <h2>Plan section length and energy before adding detail</h2>
        <p>Bar counts are flexible planning units, not mandatory commands. Use them to make section proportions and contrast explicit, then adjust by ear.</p>
      </div>
      <div class="recipe-grid blueprint-grid">
        {guide.arrangementBlueprints.map((blueprint) => (
          <details>
            <summary>{blueprint.name}</summary>
            <div class="detail-body"><p><strong>Map:</strong> {blueprint.map}</p><p><strong>Energy:</strong> {blueprint.energy}</p><p><strong>Prompt:</strong> {blueprint.prompt}</p></div>
          </details>
        ))}
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Production and mix</p>
        <h2>Place the recording in a physical space</h2>
        <p>Choose a few compatible traits. Distance, width, frequency balance, dynamics, clarity, surface and room size are all audible directions.</p>
      </div>
      <div class="vocab-grid">
        {guide.productionFamilies.map((item) => <article><h3>{item.name}</h3><p>{item.terms}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="lyrics" data-era="ai">
    <div class="shell guide-split">
      <div>
        <p class="eyebrow">Lyrics and sections</p>
        <h2>Format for breath and structure</h2>
        <ul class="check-list compact">
          {guide.lyricPrinciples.map((principle) => <li>{principle}</li>)}
        </ul>
      </div>
      <pre class="lyric-example"><code>{guide.lyricExample}</code></pre>
    </div>
  </section>

  <section class="section section--tight" id="parenthetical-rhythm" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Parentheses in lyrics</p>
        <h2>Write a vocal rhythm the model can sing</h2>
        <p>{guide.parentheticalRhythm.status}</p>
        <p>Use a three-layer approach: Style carries the global meter and groove, brackets mark sections or local performance changes, and parentheses hold possible vocal material. Parentheses are not a substitute for exact drum programming or MIDI.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Role</th><th>Purpose</th><th>Lyric example</th></tr></thead>
          <tbody>{guide.parentheticalRhythm.roles.map(([role, purpose, example]) => <tr><th scope="row">{role}</th><td>{purpose}</td><td><code class="multiline-code">{example}</code></td></tr>)}</tbody>
        </table>
      </div>
      <div class="section__head subsection-head">
        <h2>Show the grouping in the spelling</h2>
        <p>These marks suggest how syllables relate to each other. They do not force exact note values, rests or accents.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Device</th><th>Use</th><th>Example</th></tr></thead>
          <tbody>{guide.parentheticalRhythm.spellingRules.map(([device, use, example]) => <tr><th scope="row">{device}</th><td>{use}</td><td><code>{example}</code></td></tr>)}</tbody>
        </table>
      </div>
      <div class="section__head subsection-head">
        <h2>Rhythmic cells to test</h2>
        <p>Pair each lyric cell with matching meter and grouping language in Style. Generate several candidates and keep the version whose audible phrasing matches the idea.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Pattern</th><th>Parenthetical cell</th><th>What it suggests</th></tr></thead>
          <tbody>{guide.parentheticalRhythm.meterPatterns.map(([pattern, cell, note]) => <tr><th scope="row">{pattern}</th><td><code>{cell}</code></td><td>{note}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="guide-split subsection-head">
        <div>
          <h3>A complete lyric-sheet experiment</h3>
          <p>Keep the parenthetical parts short enough to fit between lead phrases. If the lead voice takes over the response, add a backing-vocal role to Style and reduce the number of syllables.</p>
          <h3>Controlled workflow</h3>
          <ol class="check-list numbered">
            {guide.parentheticalRhythm.workflow.map((step) => <li>{step}</li>)}
          </ol>
        </div>
        <pre class="lyric-example"><code>{guide.parentheticalRhythm.example}</code></pre>
      </div>
      <div class="section__head subsection-head">
        <h2>When the pattern drifts</h2>
      </div>
      <div class="trouble-list">
        {guide.parentheticalRhythm.troubleshooting.map(([problem, fix]) => <article><h3>{problem}</h3><p>{fix}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="lyric-notation" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Lyrics versus Style</p>
        <h2>Place global rhythm in Style and local changes in Lyrics</h2>
        <p>Suno documents basic structure labels such as <code>[Verse]</code>, <code>[Chorus]</code> and <code>[Bridge]</code>. The longer bracketed drum cues below are practical experiments, not a published syntax with guaranteed execution. Keep them short, listen for the intended change, and move unreliable cues into Style or the Song Editor.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Notation</th><th>Status</th><th>How to use it</th></tr></thead>
          <tbody>{guide.notationGuide.map(([notation, status, use]) => <tr><th scope="row"><code>{notation}</code></th><td>{status}</td><td>{use}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="guide-split subsection-head">
        <div>
          <h3>A full lyric-sheet experiment</h3>
          <p>Pair this with the Style example in the percussion section. The plain lyric lines remain singable; bracketed cues signal the intended local drum changes. If the model sings a cue, simplify the header and put that instruction in Style.</p>
        </div>
        <pre class="lyric-example"><code>{guide.percussionLyricExample}</code></pre>
      </div>
    </div>
  </section>

  <section class="section section--tight" id="hybrids" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">References and hybrid genres</p>
        <h2>Translate influence into audible traits</h2>
        <p>Use artist names for private listening analysis, then rewrite the reference as genre, era, rhythm, harmony, instruments, voice, arrangement and production. Describe the musical behavior instead of asking for direct imitation.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Dimension</th><th>Question</th><th>Example answer</th></tr></thead>
          <tbody>{guide.artistTranslation.map((item) => <tr><th scope="row">{item.dimension}</th><td>{item.question}</td><td>{item.example}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="section__head subsection-head">
        <h2>Give each genre a separate role</h2>
        <p>A clear hybrid assigns structure, timbre, rhythm, voice or production to each influence.</p>
      </div>
      <div class="hybrid-grid">
        {guide.hybridPatterns.map(([name, method, example]) => (
          <article><h3>{name}</h3><p>{method}</p><p><strong>Example:</strong> {example}</p></article>
        ))}
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Exclude field</p>
        <h2>Remove defaults directly</h2>
      </div>
      <div class="exclude-grid">
        {guide.excludeSets.map(([goal, terms]) => <article><h3>{goal}</h3><p>{terms}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="controls" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Advanced controls</p>
        <h2>Choose the smallest useful intervention</h2>
        <p>Lock the parts that already work. Use a targeted control when the problem is local.</p>
      </div>
      <div class="model-grid">
        {guide.models.map((model) => <article><h3>{model.name}</h3><p><strong>{model.use}</strong></p><p>{model.approach}</p></article>)}
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Control</th><th>What it changes</th><th>Working method</th></tr></thead>
          <tbody>
            {guide.controls.map((control) => (
              <tr><th scope="row">{control.name}</th><td>{control.purpose}</td><td>{control.method}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="protocol-card">
        <h3>A/B testing protocol</h3>
        <ol>{guide.testProtocol.map((step) => <li>{step}</li>)}</ol>
      </div>
    </div>
  </section>

  <section class="section section--tight" id="workflow" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Prompt, edit or produce?</p>
        <h2>Use the smallest tool that matches the problem</h2>
        <p>A new prompt is useful when the whole musical idea is open. Local faults are usually better handled with a section edit, extension, stem, uploaded reference or MIDI correction.</p>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Method</th><th>Use it when</th><th>Working approach</th></tr></thead>
          <tbody>{guide.workflowDecisions.map(([method, when, approach]) => <tr><th scope="row">{method}</th><td>{when}</td><td>{approach}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Control boundary</p>
        <h2>Know which instructions are exact and which require listening</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Control level</th><th>Examples</th><th>Expectation</th></tr></thead>
          <tbody>{guide.controlBoundaries.map(([level, examples, expectation]) => <tr><th scope="row">{level}</th><td>{examples}</td><td>{expectation}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Studio production</p>
        <h2>Move from generated mix to editable project</h2>
        <p>Studio 2.0 adds MIDI, detailed stem separation, effects and automation. Check timing and pitch before polishing because production cannot repair the wrong musical decision.</p>
      </div>
      <div class="vocab-grid">
        {guide.studioProductionWorkflow.map(([step, action]) => <article><h3>{step}</h3><p>{action}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="troubleshooting" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Troubleshooting</p>
        <h2>Revise one layer at a time</h2>
        <p>Each revision should test a specific cause. Keep the model, lyrics and sliders fixed while testing a style-prompt change.</p>
      </div>
      <div class="trouble-list">
        {guide.troubleshooting.map((item) => (
          <article><h3>{item.symptom}</h3><p>{item.revision}</p></article>
        ))}
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Generation diagnosis</p>
        <h2>Connect the audible result to one next experiment</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Result</th><th>Likely cause</th><th>Next experiment</th></tr></thead>
          <tbody>{guide.generationDiagnosis.map(([result, cause, next]) => <tr><th scope="row">{result}</th><td>{cause}</td><td>{next}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Before and after</p>
        <h2>Replace vague intention with audible behavior</h2>
      </div>
      <div class="lab-grid">
        {guide.promptLaboratory.map(([dimension, weak, improved, why]) => (
          <article class="reference-card"><h3>{dimension}</h3><p><strong>Weak:</strong> {weak}</p><p><strong>Improved:</strong> {improved}</p><p>{why}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="recipes" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Copy-ready starting points</p>
        <h2>Prompt recipes</h2>
        <p>Use these as test cases. Change one dimension at a time so you can hear what each revision did.</p>
      </div>
      <div class="recipe-grid">
        {guide.recipes.map((recipe, index) => (
          <details open={index === 0}>
            <summary>{recipe.name}</summary>
            <p>{recipe.prompt}</p>
          </details>
        ))}
      </div>
      <div class="section__head subsection-head">
        <p class="eyebrow">Master vocabulary</p>
        <h2>Pick one or two terms from each useful family</h2>
        <p>Do not paste every term into one prompt. Use this palette to replace vague adjectives with specific performance and recording choices.</p>
      </div>
      <div class="vocab-grid">
        {guide.vocabulary.map((item) => <article><h3>{item.family}</h3><p>{item.terms}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="project-bible" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Project-level prompting</p>
        <h2>Build a style bible for an EP or concept album</h2>
        <p>Consistency comes from repeating a few deliberate rules, not pasting one identical prompt into every song. Define the project’s harmonic, rhythmic, vocal and production boundaries, then give each track a separate narrative role.</p>
      </div>
      <div class="vocab-grid">
        {guide.projectStyleBible.map(([area, direction]) => <article><h3>{area}</h3><p>{direction}</p></article>)}
      </div>
      <aside class="principle">
        <strong>Keep a continuity log.</strong>
        <span>For every accepted track, record the prompt, model, settings, key, BPM, meter, voice description, recurring motif and production choices. Use the log to decide what the next song should preserve or contrast.</span>
      </aside>
    </div>
  </section>

  <section class="section section--tight" id="checklist" data-era="ai">
    <div class="shell guide-split">
      <div>
        <p class="eyebrow">Before generating</p>
        <h2>Prompt checklist</h2>
        <ol class="check-list numbered">
          {guide.checklist.map((item) => <li>{item}</li>)}
        </ol>
      </div>
      <aside class="evidence-card">
        <p class="eyebrow">Evidence boundary</p>
        <h3>Controls are explicit. Musical language is probabilistic.</h3>
        <p>{guide.evidenceNote}</p>
        <p>Suno changes quickly. Check current model names, feature access and control behavior against Suno’s Help Center.</p>
        <p><a href="https://help.suno.com/">Visit the Suno Help Center</a></p>
      </aside>
    </div>
    <div class="shell template-grid">
      <article class="prompt-card"><p class="eyebrow">Minimal template</p><p>{guide.templates.minimal}</p></article>
      <article class="prompt-card"><p class="eyebrow">Advanced template</p><p>{guide.templates.advanced}</p></article>
    </div>
    <div class="shell scorecard">
      <h3>Score each candidate from 1 to 5</h3>
      <div class="vocab-grid">
        {guide.evaluation.map(([dimension, question]) => <article><h3>{dimension}</h3><p>{question}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tight" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Sources and limits</p>
        <h2>What Suno documents</h2>
        <p>These sources support the product controls, musical terminology and working methods in this guide. The detailed key, chord, meter and percussion phrases are descriptions to test by ear. Suno does not publish a deterministic command language for exact notes or drum placement.</p>
      </div>
      <ul class="source-list">
        <li><a href="https://suno.com/hub/how-to-make-a-song">Suno: How to Make a Song</a>: Custom lyrics, Style direction and basic section markers.</li>
        <li><a href="https://suno.com/hub/step-by-step-guide-how-to-make-beats-with-suno">Suno: How to Make Beats</a>: concise beat prompts naming tempo, genre, rhythm and instruments.</li>
        <li><a href="https://suno.com/music-library/genres">Suno Music Library: Genres</a>: examples of genre and subgenre language in published tracks.</li>
        <li><a href="https://help.suno.com/en/articles/2415873">Suno Help: Can I Use My Own Lyrics?</a>: Custom mode lyric field.</li>
        <li><a href="https://help.suno.com/en/articles/3161921">Suno Help: Exclude</a>: excluding unwanted elements.</li>
        <li><a href="https://help.suno.com/en/articles/6141377">Suno Help: Creative Sliders</a>: Weirdness, Style Influence and Audio Influence.</li>
        <li><a href="https://help.suno.com/en/articles/6141505">Suno Help: Song Editor</a>: replacing and extending sections after generation.</li>
        <li><a href="https://help.suno.com/en/articles/9010177">Suno Help: Music Glossary</a>: keys, chord progressions, meter, groove, syncopation, cadence and other musical terms.</li>
        <li><a href="https://suno.com/song/7f04ba09-4093-4b75-b29b-45f128166404">Published Suno song example: If I Rule the World</a>: practical use of parenthetical echoes, responses and rhythmic syllables. This is evidence of creator practice, not product syntax documentation.</li>
        <li><a href="https://suno.com/song/d5bc2bd6-5cc6-4f02-98ee-a2b673ef1123">Published Suno song example: Bad</a>: practical use of a stuttered parenthetical vocal hook. This is evidence of creator practice, not product syntax documentation.</li>
        <li><a href="https://help.suno.com/en/articles/10625089">Suno Help: Studio 1.2</a>: time-signature grid behavior and its separation from clip generation.</li>
        <li><a href="https://help.suno.com/en/articles/13670593">Suno Help: MIDI in Studio</a>: piano roll, Key and Scale assistance, chord modes and the arpeggiator.</li>
        <li><a href="https://help.suno.com/en/articles/13670529">Suno Help: Studio 2.0</a>: MIDI, effects, automation, advanced stems and chat-assisted production.</li>
        <li><a href="https://help.suno.com/en/articles/13925185">Suno Help: Stem Separation</a>: instrument and vocal separation modes for production work.</li>
        <li><a href="https://help.suno.com/en/articles/13925249">Suno Help: Exporting from Studio</a>: full mix, selected range, multitrack, WAV and MIDI export workflows.</li>
        <li><a href="https://help.suno.com/en/articles/2477633">Suno Help: Upload Audio</a>: extending from audio you own, including a four-bar drum loop.</li>
        <li><a href="https://help.suno.com/en/articles/13924481">Suno Help: v6 FAQ</a>: Variety, Max Mode and model behavior.</li>
        <li><a href="https://online.berklee.edu/takenote/harmonic-progressions-for-songwriters/">Berklee Online: Harmonic Progressions for Songwriters</a>: chord function, harmonic rhythm, borrowed chords and voice leading.</li>
        <li><a href="https://online.berklee.edu/courses/time-and-rhythm-1">Berklee Online: Time and Rhythm 1</a>: simple and compound meter, beat grouping, syncopation and polyrhythm.</li>
        <li><a href="https://learningmusic.ableton.com/chords/play-with-chords.html">Ableton Learning Music: Play with Chords</a>: interactive key, mode and chord relationships.</li>
      </ul>
    </div>
  </section>

