---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AcousticReimaginingAlbums from '../components/AcousticReimaginingAlbums.astro';
import { sunoAlbums, sunoCollections, sunoPlaylists, sunoPublishedCount, sunoSongs } from '../data/catalog';
import { SITE } from '../data/catalog-model';
import { aiMusicPerspective } from '../data/editorial';

const runtime = (seconds?: number) => {
  if (!seconds) return undefined;
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.round((seconds % 3600) / 60);
  return hours ? `${hours} hr ${minutes} min` : `${minutes} min`;
};
const groups = [
  {
    eyebrow: 'Official Suno albums',
    title: 'Albums',
    description: 'Collections published with Suno’s album feature, with their complete track order and direct song links.',
    playlists: sunoAlbums,
  },
  {
    eyebrow: 'Album-length projects',
    title: 'Albums and concept albums',
    description: 'Focused sequences built around a sustained inner conflict or a single larger idea.',
    playlists: sunoPlaylists.filter((playlist) => playlist.collectionType === 'album'),
  },
  {
    eyebrow: 'Browse by theme',
    title: 'Thematic and cover collections',
    description: 'Broader listening pools organized by mood, subject or production approach.',
    playlists: sunoPlaylists.filter((playlist) => playlist.collectionType !== 'album'),
  },
];
const jsonLd = [{
  '@type': 'CollectionPage',
  '@id': `${SITE}/suno/#page`,
  name: 'Alex Merced’s Suno albums and playlists',
  url: `${SITE}/suno/`,
  about: { '@id': `${SITE}/#musicgroup` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: sunoCollections.length,
    itemListElement: sunoCollections.map((playlist, index) => ({
      '@type': playlist.resourceType === 'album' ? 'MusicAlbum' : 'MusicPlaylist',
      position: index + 1,
      name: playlist.name,
      url: `${SITE}${playlist.pageUrl}`,
      sameAs: playlist.url,
      numTracks: playlist.songCount,
      image: playlist.imageUrl,
      description: playlist.description,
      byArtist: { '@id': `${SITE}/#musicgroup` },
    })),
  },
  subjectOf: {
    '@type': 'Article',
    headline: aiMusicPerspective.title,
    url: aiMusicPerspective.url,
    datePublished: aiMusicPerspective.publishedAt,
    author: { '@id': 'https://alexmerced.com/#alexmerced' },
  },
}, {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Suno albums and playlists', item: `${SITE}/suno/` },
  ],
}];
---

<Base title="Suno albums and playlists" description={`All ${sunoAlbums.length} official albums and ${sunoPlaylists.length} public Alex Merced playlists on Suno, with direct links, artwork, track counts and runtimes.`} keywords={['Alex Merced Suno', 'Suno albums', 'Suno playlists', 'AI music playlists']} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Suno albums and playlists' }]} />
  <section class="section" data-era="ai">
    <div class="shell">
      <p class="eyebrow">Public Suno collections</p>
      <h1>Choose a thread through the songs</h1>
      <p class="lede">Alex’s {sunoPublishedCount} public Suno generations are organized into {sunoAlbums.length} official albums and {sunoPlaylists.length} playlists by project, subject and mood. These links and counts come directly from the public Suno profile.</p>
      <p>Start with the two albums that place Alex’s original acoustic recordings directly beside their AI reimaginings.</p>
      <div style="margin-top:1.6rem"><AcousticReimaginingAlbums /></div>
      <div class="btn-row" style="margin-top:1.6rem">
        <a class="btn" href="https://suno.com/@alexmerced">Open the Suno profile ↗</a>
        <a class="btn" href="/songs/?kind=generated">Explore all {sunoSongs.length} generated songs</a>
        <a class="btn" href="/suno-prompting-guide/">Read the prompting guide</a>
        <a class="btn" href={aiMusicPerspective.url}>Read Alex’s view on AI and art ↗</a>
      </div>
    </div>
  </section>

  <section class="section section--tight" data-era="ai">
    <div class="shell">
      <article class="card card--era" data-era="ai">
        <p class="eyebrow">Alex’s perspective</p>
        <h2><a href={aiMusicPerspective.url}>{aiMusicPerspective.title}</a></h2>
        <p>{aiMusicPerspective.description}</p>
        <p><a href={aiMusicPerspective.url}>Read the article on Data, Lakehouse and AI ↗</a></p>
      </article>
    </div>
  </section>

  {groups.map((group) => (
    <section class="section section--tight" data-era="ai">
      <div class="shell">
        <div class="section__head">
          <p class="eyebrow">{group.eyebrow}</p>
          <h2>{group.title}</h2>
          <p>{group.description}</p>
        </div>
        <div class="grid grid--2">
          {group.playlists.map((playlist) => (
            <article class="card playlist-card">
              {playlist.imageUrl && <img src={playlist.imageUrl} width="240" height="240" loading="lazy" alt={`Artwork for ${playlist.name}`} />}
              <div>
                <p class="eyebrow">{playlist.collectionLabel}</p>
                <h3><a href={playlist.pageUrl}>{playlist.name}</a></h3>
                <p>{playlist.songCount} songs{runtime(playlist.durationSeconds) ? ` · ${runtime(playlist.durationSeconds)}` : ''}</p>
                <p>{playlist.description}</p>
                <div class="btn-row"><a class="btn btn--primary" href={playlist.pageUrl}>View track list</a><a class="btn" href={playlist.url}>Listen on Suno ↗</a></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}
</Base>

<style>
  .playlist-card { display:grid; grid-template-columns:7rem 1fr; gap:1rem; align-items:start; }
  .playlist-card img { width:7rem; aspect-ratio:1; object-fit:cover; border-radius:var(--radius); }
  .playlist-card h3 { font-size:1.25rem; margin-top:.35rem; }
  .playlist-card p:last-child { margin-bottom:0; }
  @media (max-width:34rem) { .playlist-card { grid-template-columns:5rem 1fr; } .playlist-card img { width:5rem; } }
</style>
