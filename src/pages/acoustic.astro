---
import Base from '../layouts/Base.astro';
import {
  acousticTracks,
  acousticPlaylist,
  channelAcousticTracks,
  reimagined,
  soundcloudAcousticTracks,
  youtubeArchiveTracks,
} from '../data/catalog';

const rebuiltByOriginal = new Map(
  reimagined.filter((r) => r.original).map((r) => [r.original, r]),
);

const jsonLd = [
  {
    '@type': 'MusicPlaylist',
    '@id': 'https://alexmercedmusic.com/acoustic#playlist',
    name: acousticPlaylist.title,
    url: acousticPlaylist.url,
    numTracks: youtubeArchiveTracks.length,
    description: acousticPlaylist.description,
    byArtist: { '@id': 'https://alexmercedmusic.com/#musicgroup' },
    track: youtubeArchiveTracks.map((t, i) => ({
      '@type': 'MusicRecording',
      position: i + 1,
      name: t.title,
      url: t.url,
      byArtist: { '@id': 'https://alexmercedmusic.com/#musicgroup' },
    })),
  },
];
---

<Base
  title="The acoustic archive"
  description="Guitar and voice recordings by Alex Merced, uploaded from the mid-2000s onward. Songs, improvisations and takes from a bedroom and a camera, listed in full."
  keywords={['Alex Merced acoustic', 'singer songwriter', 'guitar recordings', 'YouTube']}
  jsonLd={jsonLd}
>
  <section class="section" data-era="acoustic">
    <div class="shell hero__grid">
      <div>
      <p class="eyebrow">Era one</p>
      <h1>A guitar and a camera</h1>
      <p class="lede">
        These are the oldest recordings on the site, and the ones the rest of it keeps
        coming back to. Most went up on his YouTube channel, in the years
        when putting a song on the internet meant pointing a camcorder at yourself and
        hoping the take held together.
      </p>
      <p class="lede" style="margin-top:1rem">
        {acousticTracks.length} accessible recordings are listed below across the old
        YouTube playlist, the current music channel and the loose-tracks SoundCloud
        account. {`The playlist itself reports ${acousticPlaylist.totalEntries} entries,
        but YouTube hides ${acousticPlaylist.unavailableEntries} unavailable videos.
        Titles are preserved as the hosts present them.`}
      </p>
      <div class="btn-row" style="margin-top:1.8rem">
        <a class="btn btn--primary" href={acousticPlaylist.url}>Play the whole thing</a>
        <a class="btn" href="/reimagined">Hear eight songs rebuilt</a>
      </div>
      </div>
      <img
        class="hero__portrait"
        src="/images/portrait-acoustic.webp"
        width="720" height="720"
        alt="Alex Merced"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="section" data-era="acoustic">
    <div class="shell">
      <div class="section__head">
        <h2>The YouTube archive playlist</h2>
        <p>
          {youtubeArchiveTracks.length} accessible videos in current playlist order.
          Rebuilt songs include direct links to both the original and new versions.
        </p>
      </div>
      <ol class="tracks">
        {youtubeArchiveTracks.map((t, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span>
              {t.url ? <a class="song-link" href={t.url}>{t.title}</a> : t.title}
              {rebuiltByOriginal.has(t.title) && (
                <span class="source-links source-links--inline">
                  <a href={t.url}>Original ↗</a>
                  {rebuiltByOriginal.get(t.title)?.links?.map((link) => (
                    <a href={link.url}>Rebuilt · {link.source === 'youtube' ? 'YouTube' : 'Suno'} ↗</a>
                  ))}
                </span>
              )}
            </span>
            <span class="len">{t.length} · <a class="platform-link" href={t.url}>YouTube ↗</a></span>
          </li>
        ))}
      </ol>

      <div class="section__head" style="margin-top:3rem">
        <h2>Elsewhere on the music channel</h2>
        <p>Three performances published on the channel but not filed in the old playlist.</p>
      </div>
      <ol class="tracks">
        {channelAcousticTracks.map((t, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span><a class="song-link" href={t.url}>{t.title}</a></span>
            <span class="len">{t.length} · <a class="platform-link" href={t.url}>YouTube ↗</a></span>
          </li>
        ))}
      </ol>

      <div class="section__head" style="margin-top:3rem">
        <h2>SoundCloud-only recordings</h2>
        <p>Eight singer-songwriter tracks on the second SoundCloud account that are not part of the electronic merge.</p>
      </div>
      <ol class="tracks">
        {soundcloudAcousticTracks.map((t, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span><a class="song-link" href={t.url}>{t.title}</a></span>
            <span class="len"><a class="platform-link" href={t.url}>SoundCloud ↗</a></span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
