---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE, songs } from '../../data/catalog-model';

const PAGE_SIZE = 48;
const albums = [...new Set(songs.map((song) => song.album).filter(Boolean))].sort();
const initialSongs = songs.slice(0, PAGE_SIZE);
const sectionLabel = { archive: 'Acoustic archive', electronic: 'Electronic', reimagined: 'Reimagined', generated: 'New with Suno' };
const jsonLd = [{
  '@type': 'CollectionPage', '@id': `${SITE}/songs/#page`, name: 'Explore every Alex Merced song', url: `${SITE}/songs/`, about: { '@id': `${SITE}/#musicgroup` },
  mainEntity: { '@type': 'ItemList', numberOfItems: songs.length, itemListElement: initialSongs.map((song, index) => ({ '@type': 'ListItem', position: index + 1, url: song.pageUrl, name: song.title })) },
}, { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: 'Explore songs', item: `${SITE}/songs/` }] }];
---

<Base title="Explore every song" description={`Search and filter all ${songs.length} Alex Merced recordings by era, type, album and listening platform.`} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Explore songs' }]} />
  <section class="section section--tight"><div class="shell"><p class="eyebrow">The complete catalog</p><h1>Find something to hear</h1><p class="lede">Search all {songs.length} acoustic recordings, electronic productions, reimagined songs and newer Suno releases from one place.</p></div></section>
  <section class="section section--tight"><div class="shell">
    <div class="explorer" aria-label="Song filters">
      <label><span>Search</span><input id="song-query" type="search" placeholder="Song title, style or album" autocomplete="off" /></label>
      <label><span>Era</span><select id="song-era"><option value="all">All eras</option><option value="acoustic">Acoustic</option><option value="electronic">Electronic</option><option value="ai">AI and reimagined</option></select></label>
      <label><span>Type</span><select id="song-kind"><option value="all">All types</option><option value="archive">Archive recording</option><option value="electronic">Electronic</option><option value="reimagined">Reimagined</option><option value="generated">New with Suno</option></select></label>
      <label><span>Platform</span><select id="song-source"><option value="all">All platforms</option><option value="youtube">YouTube</option><option value="suno">Suno</option><option value="soundcloud">SoundCloud</option><option value="reverbnation">ReverbNation</option></select></label>
      <label><span>Album</span><select id="song-album"><option value="all">All albums</option>{albums.map((album) => <option value={album}>{album}</option>)}</select></label>
      <label><span>Sort</span><select id="song-sort"><option value="catalog">Catalog order</option><option value="newest">Newest dated first</option><option value="az">Title A-Z</option><option value="duration">Longest first</option></select></label>
    </div>
    <div class="explorer__actions"><p id="song-count" aria-live="polite">Showing {initialSongs.length} of {songs.length} songs</p><button class="btn" type="button" id="surprise">Surprise me</button><button class="btn" type="button" id="reset">Reset filters</button></div>
    <div class="song-grid" id="song-grid" aria-busy="false">
      {initialSongs.map((song) => <article class="song-card card card--era" data-era={song.era}><p class="eyebrow">{sectionLabel[song.kind]}</p><h2><a href={song.pageUrl.replace(SITE, '')}>{song.title}</a></h2><p>{song.album ?? song.genres?.slice(0, 3).join(' · ') ?? song.style ?? 'Alex Merced Music'}</p><div class="song-card__actions"><a href={song.pageUrl.replace(SITE, '')}>Details</a><a href={song.links[0].url}>Source ↗</a></div></article>)}
    </div>
    <p id="song-empty" class="empty" hidden>No songs match those filters.</p>
    <div class="load-more"><button class="btn" type="button" id="load-more">Load more songs</button></div>
    <noscript><p class="empty">JavaScript is required to filter the full catalog. The first {PAGE_SIZE} songs remain available above, and the complete catalog is also available in <a href="/catalog.json">catalog.json</a>.</p></noscript>
  </div></section>
</Base>

<style>
  .explorer{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:.8rem}.explorer label{display:grid;gap:.35rem}.explorer label span{font:600 .68rem/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-faint)}.explorer input,.explorer select{width:100%;min-height:2.7rem;padding:.62rem .7rem;border:1px solid var(--rule);border-radius:var(--radius);background:var(--night-800);color:var(--ink);font:inherit;font-size:.88rem}.explorer__actions{display:flex;align-items:center;flex-wrap:wrap;gap:.7rem;margin:1rem 0 1.5rem}.explorer__actions p{margin:0 auto 0 0;color:var(--ink-faint);font:500 .8rem/1 var(--mono)}.song-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(17rem,1fr));gap:.75rem}.song-card .eyebrow{color:var(--era);margin:0}.song-card h2{font-size:1.08rem;line-height:1.25}.song-card h2 a{text-decoration:none}.song-card h2 a:hover{color:var(--era);text-decoration:underline;text-underline-offset:.18em}.song-card__actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:auto;padding-top:.3rem}.song-card__actions a,.song-card__actions button{border:0;padding:0;background:none;color:var(--era);font:650 .73rem/1 var(--mono);cursor:pointer;text-decoration:none}.song-card__actions a:hover,.song-card__actions button:hover{color:var(--ink);text-decoration:underline}.load-more{display:flex;justify-content:center;margin-top:1.5rem}
</style>

<script>
  type SongIndexItem = { id:string; index:number; title:string; pageUrl:string; era:string; kind:string; album:string|null; genres:string[]; style:string|null; sources:string[]; sourceUrl:string; createdAt:string|null; duration:number; embedUrl:string|null };
  const PAGE_SIZE = 48;
  const labels:Record<string,string> = { archive:'Acoustic archive',electronic:'Electronic',reimagined:'Reimagined',generated:'New with Suno' };
  const grid=document.getElementById('song-grid')!; const query=document.getElementById('song-query') as HTMLInputElement; const era=document.getElementById('song-era') as HTMLSelectElement; const kind=document.getElementById('song-kind') as HTMLSelectElement; const source=document.getElementById('song-source') as HTMLSelectElement; const album=document.getElementById('song-album') as HTMLSelectElement; const sort=document.getElementById('song-sort') as HTMLSelectElement; const count=document.getElementById('song-count')!; const empty=document.getElementById('song-empty')!; const more=document.getElementById('load-more') as HTMLButtonElement;
  let all:SongIndexItem[]=[]; let matched:SongIndexItem[]=[]; let visible=PAGE_SIZE;
  const element=(tag:string,className?:string,text?:string)=>{const node=document.createElement(tag);if(className)node.className=className;if(text)node.textContent=text;return node};
  const render=()=>{grid.replaceChildren();for(const song of matched.slice(0,visible)){const card=element('article','song-card card card--era');card.dataset.era=song.era;const eyebrow=element('p','eyebrow',labels[song.kind]??song.kind);const heading=element('h2');const detail=document.createElement('a');detail.href=song.pageUrl;detail.textContent=song.title;heading.append(detail);const note=element('p','',song.album||song.genres.slice(0,3).join(' · ')||song.style||'Alex Merced Music');const actions=element('div','song-card__actions');const details=document.createElement('a');details.href=song.pageUrl;details.textContent='Details';actions.append(details);if(song.embedUrl){const play=document.createElement('button');play.type='button';play.textContent='Play here';play.dataset.embedUrl=song.embedUrl;play.dataset.trackTitle=song.title;actions.append(play)}const external=document.createElement('a');external.href=song.sourceUrl;external.textContent='Source ↗';actions.append(external);card.append(eyebrow,heading,note,actions);grid.append(card)}count.textContent=`Showing ${Math.min(visible,matched.length)} of ${matched.length} matching songs (${all.length} total)`;empty.hidden=matched.length>0;more.hidden=visible>=matched.length;grid.setAttribute('aria-busy','false')};
  const apply=()=>{visible=PAGE_SIZE;const term=query.value.trim().toLowerCase();matched=all.filter((song)=>(!term||`${song.title} ${song.genres.join(' ')} ${song.album??''} ${song.style??''}`.toLowerCase().includes(term))&&(era.value==='all'||song.era===era.value)&&(kind.value==='all'||song.kind===kind.value)&&(source.value==='all'||song.sources.includes(source.value))&&(album.value==='all'||song.album===album.value));matched.sort((a,b)=>sort.value==='az'?a.title.localeCompare(b.title):sort.value==='newest'?Date.parse(b.createdAt??'1900')-Date.parse(a.createdAt??'1900'):sort.value==='duration'?b.duration-a.duration:a.index-b.index);const params=new URLSearchParams();if(term)params.set('q',term);for(const [control,key,initial] of [[era,'era','all'],[kind,'kind','all'],[source,'source','all'],[album,'album','all'],[sort,'sort','catalog']] as const)if(control.value!==initial)params.set(key,control.value);history.replaceState(null,'',`${location.pathname}${params.size?`?${params}`:''}`);render()};
  const params=new URLSearchParams(location.search);query.value=params.get('q')??'';for(const [control,key] of [[era,'era'],[kind,'kind'],[source,'source'],[album,'album'],[sort,'sort']] as const){const value=params.get(key);if(value&&[...control.options].some((option)=>option.value===value))control.value=value}
  grid.setAttribute('aria-busy','true');fetch('/song-index.json').then((response)=>{if(!response.ok)throw new Error(String(response.status));return response.json()}).then((data)=>{all=data.songs;apply()}).catch(()=>{grid.setAttribute('aria-busy','false');count.textContent='The full filter index could not load. The first songs remain available.';more.hidden=true});
  for(const control of [query,era,kind,source,album,sort])control.addEventListener(control===query?'input':'change',apply);more.addEventListener('click',()=>{visible+=PAGE_SIZE;render()});document.getElementById('reset')!.addEventListener('click',()=>{query.value='';for(const select of [era,kind,source,album])select.value='all';sort.value='catalog';apply()});document.getElementById('surprise')!.addEventListener('click',()=>{const selected=matched[Math.floor(Math.random()*matched.length)];if(selected)location.href=selected.pageUrl});
</script>
