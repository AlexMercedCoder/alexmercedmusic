---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { CATALOG_SCHEMA_VERSION, SITE } from '../data/catalog-model';
const tools = [
  ['music_overview', 'Current catalog counts, eras and primary destinations.'],
  ['get_song', 'One exact recording by stable ID, slug or exact title.'],
  ['search_songs', 'Full-text discovery with era, kind, album and source filters.'],
  ['list_songs', 'Paginated catalog browsing without a search term.'],
  ['get_recent_songs', 'The most recently published dated recordings.'],
  ['list_videos', 'Every public channel video, searchable and filterable by song connection.'],
  ['get_video', 'One video with matching song records and other known versions.'],
  ['compare_versions', 'An original recording and every known reimagined version.'],
  ['list_suno_playlists', 'Every public Suno playlist with its direct URL, artwork, song count and runtime.'],
  ['get_suno_playlist', 'One playlist and its ordered local song records.'],
  ['get_catalog_updates_since', 'Dated recordings published after an ISO date for lightweight polling.'],
  ['get_suno_prompting_guide', 'Structured prompt architecture, keys, chord progressions, time signatures, percussion, sound palettes, controls and troubleshooting.'],
  ['get_suno_prompting_section', 'One focused guide section, such as harmony, rhythm, vocals, production, recipes or troubleshooting.'],
  ['search_suno_prompting_guide', 'Search the guide for a key, chord progression, meter, percussion idea, musical problem, genre or instrument.'],
  ['compose_suno_prompt', 'Assemble a focused Style prompt from separate musical choices without sending data to Suno.'],
  ['list_reimaginings', 'Every original/reimagined pair.'],
  ['list_albums', 'Albums or one complete album track list.'],
  ['where_to_listen', 'Verified hosting profiles and playlists by era.'],
  ['get_ai_music_perspective', 'Alex’s first-person article about AI-assisted creativity, artistic skill, access and the effect on working artists.'],
  ['navigate_catalog', 'Canonical human and machine-readable site destinations.'],
];
---

<Base title="WebMCP tools" description="How browser agents can search, navigate and understand the Alex Merced Music catalog through read-only WebMCP tools.">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'WebMCP tools' }]} />
  <article class="section prose">
    <div class="shell prose__body" style="margin-top:0">
      <p class="eyebrow">Agent interface · schema {CATALOG_SCHEMA_VERSION}</p>
      <h1>WebMCP for the music catalog</h1>
      <p class="lede">AlexMercedMusic.com registers twenty read-only browser tools. Agents can find recordings and videos, follow media connections, inspect ordered Suno playlists, poll for newer publications, search prompting guidance, read Alex’s stated perspective on AI and music, compare versions and navigate to canonical pages without scraping visual lists.</p>
      <h2>Available tools</h2>
      <dl class="facts">
        {tools.map(([name, description]) => <div><dt><code>{name}</code></dt><dd>{description}</dd></div>)}
      </dl>
      <h2>Example workflow</h2>
      <ol>
        <li>Call <code>search_songs</code> with <code>{`{"query":"Solemn Thoughts"}`}</code>.</li>
        <li>Use the returned stable ID with <code>compare_versions</code>.</li>
        <li>Open the returned canonical AlexMercedMusic.com page or a verified listening source.</li>
      </ol>
      <h2>Prompting workflow</h2>
      <ol>
        <li>Call <code>search_suno_prompting_guide</code> with a term such as <code>{`{"query":"close-mic"}`}</code>.</li>
        <li>Call <code>get_suno_prompting_section</code> for the relevant reference section.</li>
        <li>Pass the selected traits to <code>compose_suno_prompt</code> to receive a clean Style prompt and optional Exclude field.</li>
      </ol>
      <h2>Video workflow</h2>
      <ol>
        <li>Call <code>list_videos</code> with a title fragment or use the linked filter.</li>
        <li>Pass the returned YouTube ID to <code>get_video</code>.</li>
        <li>Use the matching songs and other versions to move across every known piece of media for that work.</li>
      </ol>
      <h2>Direct machine access</h2>
      <p>Clients without WebMCP can use the <a href="/catalog-summary.json">catalog summary</a>, versioned <a href="/catalog.json">JSON catalog</a>, <a href="/catalog.schema.json">JSON Schema</a>, lightweight <a href="/song-index.json">song index</a>, concise <a href="/llms.txt">LLM guide</a>, <a href="/llms-full.txt">full text catalog</a>, <a href="/feed.json">JSON Feed</a>, or <a href="/feed.xml">RSS feed</a>. All tools are read-only and have no login or side effects.</p>
      <div class="btn-row"><a class="btn" href={`${SITE}/songs/`}>Open the song explorer</a><a class="btn" href={`${SITE}/videos/`}>Open the video catalog</a></div>
    </div>
  </article>
</Base>
