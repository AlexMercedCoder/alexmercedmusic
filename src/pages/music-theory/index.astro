---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MusicTheoryWorkbench from '../../components/MusicTheoryWorkbench.astro';
import { musicTheoryGuide as theory } from '../../data/music-theory-guide';
import { SITE } from '../../data/catalog-model';

const faqs = [
  ['Do I need to read notation to use this guide?', 'No. The formulas, note names, Roman numerals, fretboard-oriented ideas and MIDI workflows can be used without staff notation. Notation remains useful when communicating exact rhythm, register and voice leading.'],
  ['Are major scales always happy and minor scales always sad?', 'No. Major and minor establish interval and harmonic relationships, not fixed emotions. Tempo, groove, register, voicing, melody, dynamics and timbre can reverse the expected impression.'],
  ['What is the difference between chord symbols and Roman numerals?', 'A chord symbol names exact pitches, such as Dm7. A Roman numeral names a chord’s relationship to the key, such as ii7, so the same function can be moved to another key.'],
  ['How should a guitarist start using Roman numerals?', 'Choose a familiar chord loop, identify the key, label each chord by scale degree, then move the same numerals to a new key or capo position.'],
  ['How should a DAW producer apply scales?', 'Set a tonal center, constrain MIDI notes to a scale, build bass and chords from scale degrees, and emphasize chord tones on strong beats. Use out-of-scale notes deliberately as approaches, borrowed colors or modulation.'],
  ['How do I choose a scale for a chord progression?', 'Begin with the parent key when the chords are diatonic. For modal or chromatic harmony, identify the tonic, chord qualities and characteristic notes, then select a scale that supports those tones without erasing the progression’s function.'],
  ['Can I hear and download the chord progressions?', 'Yes. The progression tool can synthesize a preview in the browser, download the selected sound as a WAV file and export editable MIDI for a DAW. No recording or musical choice is uploaded to a server.'],
];

const jsonLd = [
  { '@type': 'TechArticle', '@id': `${SITE}/music-theory/#article`, headline: theory.title, description: theory.description, url: theory.pageUrl, datePublished: '2026-10-07', dateModified: '2026-10-07', author: { '@id': 'https://alexmerced.com/#alexmerced' }, publisher: { '@id': 'https://alexmerced.com/#alexmerced' }, about: ['music theory', 'songwriting', 'chords', 'scales', 'modes', 'Roman numeral analysis', 'electronic music production'], proficiencyLevel: 'Beginner to advanced' },
  { '@type': 'FAQPage', mainEntity: faqs.map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: theory.title, item: theory.pageUrl }] },
];
---

<Base title={theory.title} description={theory.description} keywords={['music theory for songwriters', 'music theory for producers', 'Roman numeral chord progressions', 'musical modes', 'scale formulas', 'chord builder', 'guitar songwriting theory', 'DAW music theory']} jsonLd={jsonLd} ogType="article" dateModified="2026-10-07">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Music Theory' }]} />
  <section class="section theory-hero" data-era="electronic"><div class="shell"><p class="eyebrow">For songs, instruments and productions</p><h1>Music theory you can put to work</h1><p class="lede">Build scales and chords, translate Roman numerals, hear progressions, download WAV and MIDI files, choose modal colors and turn theory into parts for guitar, keyboard, voice or a DAW.</p><div class="guide-meta"><span>Standalone reference</span><span>Beginner to advanced</span><span>Browser-local audio tools</span><span>Research verified October 7, 2026</span></div><div class="btn-row"><a class="btn btn--primary" href="#workbench">Open the theory lab</a><a class="btn" href="#progressions">Browse progressions</a><a class="btn" href="/suno-prompting-guide/">Suno prompting guide</a></div></div></section>

  <nav class="theory-nav" aria-label="Theory sections"><div class="shell"><a href="#fundamentals">Fundamentals</a><a href="#workbench">Theory lab</a><a href="#scales">Scales</a><a href="#modes">Modes</a><a href="#chords">Chords</a><a href="#roman-numerals">Roman numerals</a><a href="#progressions">Progressions</a><a href="#color">Harmonic color</a><a href="#vibes">Vibe palettes</a><a href="#melody">Melody</a><a href="#workflows">Instrument workflows</a><a href="#study">Study path</a></div></nav>

  <section class="section section--tight" id="fundamentals"><div class="shell"><div class="section__head"><p class="eyebrow">Foundations</p><h2>Hear relationships before memorizing labels</h2><p>Notes gain meaning from a tonic, rhythmic placement and surrounding harmony. Learn scale degrees and intervals as reusable relationships, then connect them to exact note names on your instrument.</p></div><div class="grid grid--4">{theory.pitchBasics.map(([name, meaning]) => <article class="theory-card"><h3>{name}</h3><p>{meaning}</p></article>)}</div><div class="section__head subsection"><h2>Interval palette</h2><p>The same interval can feel different in a melody, bass line or chord. These descriptions identify common uses, not fixed emotions.</p></div><div class="table-wrap"><table><thead><tr><th>Interval</th><th>Semitones</th><th>Common use</th></tr></thead><tbody>{theory.intervals.map(([name, semitones, use]) => <tr><th>{name}</th><td>{semitones}</td><td>{use}</td></tr>)}</tbody></table></div></div></section>

  <section class="section section--tight" id="workbench"><div class="shell"><MusicTheoryWorkbench /></div></section>

  <section class="section section--tight" id="scales"><div class="shell"><div class="section__head"><p class="eyebrow">Scale atlas</p><h2>Choose a pitch collection and establish its center</h2><p>A scale formula describes intervals above the tonic. Its musical identity becomes clear when melody, bass, harmony and emphasis reinforce the tonic and characteristic notes.</p></div><div class="atlas">{theory.scaleFamilies.map((scale) => <article class="reference-card"><h3>{scale.name}</h3><p class="formula">{scale.formula}</p><dl><div><dt>Tendency</dt><dd>{scale.tendency}</dd></div><div><dt>Harmony</dt><dd>{scale.harmony}</dd></div><div><dt>Use</dt><dd>{scale.use}</dd></div></dl></article>)}</div></div></section>

  <section class="section section--tight" id="modes"><div class="shell"><div class="section__head"><p class="eyebrow">Diatonic modes</p><h2>Change the tonal center and characteristic degree</h2><p>Modes are more than major scales beginning on different notes. Establish the modal tonic with repetition, bass, cadence and a characteristic pitch that distinguishes the mode from ordinary major or minor.</p></div><div class="table-wrap"><table><thead><tr><th>Mode</th><th>Formula</th><th>Characteristic</th><th>Tendency</th><th>Useful vamp</th></tr></thead><tbody>{theory.modes.map(([mode, formula, characteristic, tendency, vamp]) => <tr><th>{mode}</th><td>{formula}</td><td>{characteristic}</td><td>{tendency}</td><td>{vamp}</td></tr>)}</tbody></table></div></div></section>

  <section class="section section--tight" id="chords"><div class="shell"><div class="section__head"><p class="eyebrow">Chord construction</p><h2>Stack intervals, then choose voicing and register</h2><p>A chord symbol identifies a pitch structure. Its actual sound depends on which note is in the bass, how widely notes are spaced, what is omitted or doubled and which instrument plays each register.</p></div><div class="table-wrap"><table><thead><tr><th>Chord</th><th>Formula</th><th>Common character</th></tr></thead><tbody>{theory.chordConstruction.map(([name, formula, character]) => <tr><th>{name}</th><td>{formula}</td><td>{character}</td></tr>)}</tbody></table></div><div class="section__head subsection"><h2>Diatonic chord maps</h2></div><div class="grid grid--2">{theory.diatonicHarmony.map(([system, numerals, note]) => <article class="theory-card"><h3>{system}</h3><p class="formula">{numerals}</p><p>{note}</p></article>)}</div></div></section>

  <section class="section section--tight" id="roman-numerals"><div class="shell"><div class="section__head"><p class="eyebrow">Roman numerals and function</p><h2>Separate harmonic relationships from exact pitches</h2><p>Roman numerals label chord roots relative to a key. Uppercase indicates major, lowercase indicates minor, a degree sign indicates diminished and accidentals before the numeral alter the root. The same I-V-vi-IV relationship can therefore move to any key.</p></div><aside class="principle"><strong>Relative versus absolute</strong><span>In C major, ii7-V7-Imaj7 becomes Dm7-G7-Cmaj7. The Roman numerals describe function; the chord symbols tell a performer or MIDI editor which notes to play.</span></aside><div class="grid grid--3 subsection">{theory.harmonicFunctions.map(([functionName, chords, role]) => <article class="theory-card"><h3>{functionName}</h3><p class="formula">{chords}</p><p>{role}</p></article>)}</div></div></section>

  <section class="section section--tight" id="progressions"><div class="shell"><div class="section__head"><p class="eyebrow">Progression library</p><h2>Choose motion that supports the song’s job</h2><p>Progression labels describe common tendencies, not emotional guarantees. Harmonic rhythm, bass, melody, cadence, groove and voicing decide whether the same numerals feel tender, aggressive, comic or bleak.</p></div><div class="table-wrap"><table><thead><tr><th>Use</th><th>Roman numerals</th><th>Context</th><th>Motion</th></tr></thead><tbody>{theory.progressionLibrary.map(([name, roman, context, motion]) => <tr><th>{name}</th><td>{roman}</td><td>{context}</td><td>{motion}</td></tr>)}</tbody></table></div></div></section>

  <section class="section section--tight" id="color"><div class="shell"><div class="section__head"><p class="eyebrow">Beyond diatonic harmony</p><h2>Add one clear source of color</h2><p>Chromatic harmony works best when the listener can hear what remains constant. Preserve tonic, common tones, bass direction, motif or rhythm while one harmonic dimension changes.</p></div><div class="table-wrap"><table><thead><tr><th>Technique</th><th>What it does</th><th>How to use it</th></tr></thead><tbody>{theory.colorTechniques.map(([name, definition, use]) => <tr><th>{name}</th><td>{definition}</td><td>{use}</td></tr>)}</tbody></table></div></div></section>

  <section class="section section--tight" id="vibes"><div class="shell"><div class="section__head"><p class="eyebrow">Scale and progression tendencies</p><h2>Start with a palette, then shape the actual feeling</h2><p>{theory.evidenceNote}</p></div><div class="atlas">{theory.vibePalettes.map(([name, scales, progressions, arrangement]) => <article class="reference-card"><h3>{name}</h3><dl><div><dt>Scales</dt><dd>{scales}</dd></div><div><dt>Progressions</dt><dd>{progressions}</dd></div><div><dt>Arrangement</dt><dd>{arrangement}</dd></div></dl></article>)}</div></div></section>

  <section class="section section--tight" id="melody"><div class="shell"><div class="section__head"><p class="eyebrow">Melody and chord-scale connection</p><h2>Make strong beats explain the harmony</h2><p>Chord-scale theory connects a chord’s tones and available extensions to a scale, but it does not mean the key changes on every chord. Keep the larger key center and phrase direction audible while using chord tones to clarify local harmony.</p></div><div class="grid grid--2">{theory.melodyPractice.map(([practice, explanation]) => <article class="theory-card"><h3>{practice}</h3><p>{explanation}</p></article>)}</div></div></section>

  <section class="section section--tight" id="workflows"><div class="shell"><div class="section__head"><p class="eyebrow">From theory to sound</p><h2>Apply the same relationships on different tools</h2></div><div class="grid grid--3">{theory.instrumentWorkflows.map(([workflow, method]) => <article class="theory-card"><h3>{workflow}</h3><p>{method}</p></article>)}</div></div></section>

  <section class="section section--tight" id="study"><div class="shell guide-split"><div><p class="eyebrow">Practice path</p><h2>Build from hearing to analysis</h2><ol class="study-list">{theory.studySequence.map((step) => <li>{step}</li>)}</ol></div><aside class="evidence-card"><p class="eyebrow">A useful boundary</p><h3>Theory is a map of relationships.</h3><p>{theory.evidenceNote}</p><p>Break a convention deliberately after you can hear what the convention normally accomplishes.</p></aside></div></section>

  <section class="section section--tight"><div class="shell"><div class="section__head"><p class="eyebrow">Sources</p><h2>Study the underlying concepts</h2><p>This guide synthesizes standard theory concepts into practical songwriting and production workflows. Follow these open educational references for notation, analysis and deeper examples.</p></div><ul class="source-list">{theory.sources.map(([name, url]) => <li><a href={url}>{name}</a></li>)}</ul></div></section>

  <section class="section section--tight"><div class="shell"><div class="section__head"><p class="eyebrow">Common questions</p><h2>Short answers</h2></div><div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
</Base>

<style>
  .theory-hero .lede{max-width:58rem}.guide-meta{display:flex;flex-wrap:wrap;gap:.55rem;margin:1.5rem 0}.guide-meta span{border:1px solid var(--rule);border-radius:999px;padding:.35rem .7rem;color:var(--ink-soft);font:500 .72rem/1.2 var(--mono)}
  .theory-nav{position:sticky;top:68px;z-index:30;border-block:1px solid var(--rule-soft);background:color-mix(in srgb,var(--night-900) 94%,transparent);backdrop-filter:blur(10px)}.theory-nav .shell{display:flex;gap:1.2rem;overflow:auto;padding-block:.8rem}.theory-nav a{color:var(--ink-soft);font:600 .72rem/1 var(--mono);text-decoration:none;white-space:nowrap}.theory-nav a:hover{color:var(--ai)}
  .theory-card,.reference-card,.evidence-card{padding:1.25rem;border:1px solid var(--rule);border-radius:var(--radius);background:var(--night-800)}.theory-card h3,.reference-card h3{color:var(--ai);margin-bottom:.7rem}.theory-card p,.reference-card p,.evidence-card p{color:var(--ink-soft)}.formula{color:var(--ink)!important;font:650 .82rem/1.6 var(--mono)}.subsection{margin-top:clamp(2.5rem,6vw,5rem)}
  .table-wrap{overflow:auto;border:1px solid var(--rule);border-radius:var(--radius)}table{width:100%;border-collapse:collapse;min-width:48rem}th,td{padding:.8rem 1rem;text-align:left;vertical-align:top;border-bottom:1px solid var(--rule)}thead th{color:var(--ink-faint);background:var(--night-700);font:650 .7rem/1.3 var(--mono);letter-spacing:.07em;text-transform:uppercase}tbody th{color:var(--ai)}tbody td{color:var(--ink-soft)}tbody tr:last-child>*{border-bottom:0}
  .atlas{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.reference-card dl{margin:0}.reference-card dl div{display:grid;grid-template-columns:8rem 1fr;gap:1rem;padding:.6rem 0;border-top:1px solid var(--rule-soft)}.reference-card dt{color:var(--ink);font-weight:700}.reference-card dd{color:var(--ink-soft);margin:0}
  .principle{padding:1.1rem 1.3rem;border-left:3px solid var(--ai);background:var(--night-800);display:grid;grid-template-columns:auto 1fr;gap:1rem}.principle span{color:var(--ink-soft)}.guide-split{display:grid;grid-template-columns:1fr minmax(20rem,.7fr);gap:clamp(2rem,6vw,5rem)}.evidence-card{border-top:3px solid var(--ai)}.study-list{counter-reset:item;list-style:none;padding:0;display:grid;gap:.8rem}.study-list li{counter-increment:item;color:var(--ink-soft);padding-left:2.5rem;position:relative}.study-list li:before{content:counter(item,decimal-leading-zero);position:absolute;left:0;color:var(--ai);font:700 .75rem/1.6 var(--mono)}
  .source-list{display:grid;gap:.7rem;color:var(--ink-soft)}.source-list a{color:var(--ai)}.faq-list{display:grid;gap:.75rem;max-width:55rem}.faq-list details{border:1px solid var(--rule);border-radius:var(--radius);background:var(--night-800)}.faq-list summary{cursor:pointer;padding:1rem;color:var(--ink);font-weight:700}.faq-list p{padding:1rem;margin:0;color:var(--ink-soft);border-top:1px solid var(--rule)}
  @media(max-width:800px){.theory-nav{top:113px}.atlas,.guide-split{grid-template-columns:1fr}}@media(max-width:560px){.theory-nav{top:145px}.reference-card dl div{grid-template-columns:1fr;gap:.25rem}}
  @media print{.theory-nav,.btn-row,[data-theory-workbench] button{display:none!important}.section{break-inside:avoid}details>*{display:block!important}}
</style>
