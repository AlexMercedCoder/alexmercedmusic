---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VideoCatalogCard from '../../components/VideoCatalogCard.astro';
import { SITE, videos } from '../../data/catalog-model';

const PAGE_SIZE = 48;
const shorts = videos.filter((video) => video.videoType === 'short');
const standardVideos = videos.filter((video) => video.videoType === 'video');
const orderedVideos = [...shorts, ...standardVideos];
const connectedCount = videos.filter((video) => video.relatedSongIds.length).length;
const jsonLd = [{
  '@type': 'CollectionPage',
  '@id': `${SITE}/videos/#page`,
  name: 'Alex Merced YouTube Shorts and music videos',
  url: `${SITE}/videos/`,
  about: { '@id': `${SITE}/#musicgroup` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: videos.length,
    itemListElement: orderedVideos.slice(0, PAGE_SIZE).map((video, index) => ({ '@type': 'ListItem', position: index + 1, url: video.pageUrl, name: video.title })),
  },
}, {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Videos and Shorts', item: `${SITE}/videos/` },
  ],
}];

---

<Base title="Videos and Shorts" description={`Browse ${shorts.length} YouTube Shorts and ${standardVideos.length} videos from the Alex Merced Music channel, with connections to songs and alternate versions.`} jsonLd={jsonLd}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Videos and Shorts' }]} />
  <section class="section section--tight">
    <div class="shell">
      <p class="eyebrow">YouTube catalog</p>
      <h1>Videos and Shorts</h1>
      <p class="lede">Browse {shorts.length} Shorts first, followed by {standardVideos.length} full videos from the Alex Merced Music channel. Each entry connects to matching song records and other known versions when available. {connectedCount} uploads currently have a catalog connection.</p>
    </div>
  </section>
  <section class="section section--tight">
    <div class="shell">
      <div class="video-filters" aria-label="Video filters">
        <label><span>Search</span><input id="video-query" type="search" placeholder="Video, Short or song title" autocomplete="off" /></label>
        <label><span>Connection</span><select id="video-connection"><option value="all">All uploads</option><option value="linked">Linked to songs</option><option value="unlinked">Not yet linked</option></select></label>
        <label><span>Sort each section</span><select id="video-sort"><option value="channel">Newest first</option><option value="oldest">Oldest first</option><option value="az">Title A-Z</option></select></label>
      </div>
      <div class="video-actions"><p id="video-count" aria-live="polite">Showing {shorts.length} Shorts and {Math.min(PAGE_SIZE, standardVideos.length)} of {standardVideos.length} videos</p><button class="btn" id="video-reset" type="button">Reset filters</button></div>

      <section class="video-group" id="shorts-section" aria-labelledby="shorts-heading">
        <div class="video-group__head"><div><p class="eyebrow">Vertical and brief</p><h2 id="shorts-heading">Shorts</h2></div><p id="shorts-count">{shorts.length} Shorts</p></div>
        <div class="video-grid video-grid--shorts" id="shorts-grid" aria-busy="false">{shorts.slice(0, PAGE_SIZE).map((video) => <VideoCatalogCard video={video} />)}</div>
        <p id="shorts-empty" class="empty" hidden>No Shorts match those filters.</p>
        <div class="load-more"><button class="btn" type="button" id="shorts-more" hidden={shorts.length <= PAGE_SIZE}>Load more Shorts</button></div>
      </section>

      <section class="video-group" id="videos-section" aria-labelledby="videos-heading">
        <div class="video-group__head"><div><p class="eyebrow">Full recordings</p><h2 id="videos-heading">Videos</h2></div><p id="videos-count">{standardVideos.length} videos</p></div>
        <div class="video-grid" id="videos-grid" aria-busy="false">{standardVideos.slice(0, PAGE_SIZE).map((video) => <VideoCatalogCard video={video} />)}</div>
        <p id="videos-empty" class="empty" hidden>No videos match those filters.</p>
        <div class="load-more"><button class="btn" type="button" id="videos-more" hidden={standardVideos.length <= PAGE_SIZE}>Load more videos</button></div>
      </section>

      <noscript><p class="empty">Shorts are listed first, followed by the first {PAGE_SIZE} videos. The complete machine-readable catalog is available in <a href="/video-index.json">video-index.json</a>.</p></noscript>
    </div>
  </section>
</Base>

<style>
  .video-filters{display:grid;grid-template-columns:minmax(14rem,2fr) repeat(2,minmax(10rem,1fr));gap:.8rem}.video-filters label{display:grid;gap:.35rem}.video-filters span{font:600 .68rem/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink-faint)}.video-filters input,.video-filters select{width:100%;min-height:2.7rem;padding:.62rem .7rem;border:1px solid var(--rule);border-radius:var(--radius);background:var(--night-800);color:var(--ink);font:inherit;font-size:.88rem}.video-actions{display:flex;align-items:center;gap:.8rem;margin:1rem 0 2rem}.video-actions p{margin:0 auto 0 0;color:var(--ink-faint);font:500 .8rem/1.4 var(--mono)}.video-group+.video-group{margin-top:clamp(3.5rem,7vw,6rem);padding-top:clamp(2.5rem,5vw,4rem);border-top:1px solid var(--rule)}.video-group__head{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.25rem}.video-group__head .eyebrow,.video-group__head h2,.video-group__head>p{margin:0}.video-group__head h2{margin-top:.3rem}.video-group__head>p{color:var(--ink-faint);font:500 .78rem/1 var(--mono)}.video-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(18rem,1fr));gap:1rem}.video-grid--shorts{grid-template-columns:repeat(auto-fill,minmax(12rem,1fr))}:global(.video-card){overflow:hidden;background:var(--night-800);border:1px solid var(--rule);border-radius:var(--radius)}:global(.video-card__image){display:block;aspect-ratio:16/9;background:var(--night-700)}:global(.video-card--short .video-card__image){aspect-ratio:9/16}:global(.video-card__image img){width:100%;height:100%;object-fit:cover}:global(.video-card__body){display:flex;flex-direction:column;gap:.55rem;padding:1rem}:global(.video-card .eyebrow){margin:0}:global(.video-card h3){font-size:1.05rem;line-height:1.25}:global(.video-card h3 a){text-decoration:none}:global(.video-card h3 a:hover){text-decoration:underline;text-underline-offset:.18em}:global(.video-card p){margin:0;color:var(--ink-soft);font-size:.88rem}:global(.video-card__links){display:flex;flex-wrap:wrap;gap:.8rem;margin-top:.3rem}:global(.video-card__links a){color:var(--electronic);font:650 .72rem/1 var(--mono);text-decoration:none}:global(.video-card__links a:hover){color:var(--ink);text-decoration:underline}.load-more{display:flex;justify-content:center;margin-top:1.5rem}@media(max-width:700px){.video-filters{grid-template-columns:1fr}.video-grid--shorts{grid-template-columns:repeat(2,minmax(0,1fr))}:global(.video-card--short .video-card__body){padding:.75rem}:global(.video-card--short h3){font-size:.9rem}}
</style>

<script>
  type VideoItem={id:string;youtubeId:string;title:string;pageUrl:string;watchUrl:string;imageUrl:string;publishedAt:string;durationSeconds:number;videoType:'short'|'video';songIds:string[];relatedSongIds:string[]};
  type Group={section:HTMLElement;grid:HTMLElement;count:HTMLElement;empty:HTMLElement;more:HTMLButtonElement;visible:number;matched:VideoItem[]};
  const PAGE_SIZE=48;const query=document.getElementById('video-query') as HTMLInputElement;const connection=document.getElementById('video-connection') as HTMLSelectElement;const sort=document.getElementById('video-sort') as HTMLSelectElement;const totalCount=document.getElementById('video-count')!;let all:VideoItem[]=[];
  const group=(type:'short'|'video'):Group=>{const name=type==='short'?'shorts':'videos';return{section:document.getElementById(`${name}-section`)! as HTMLElement,grid:document.getElementById(`${name}-grid`)!,count:document.getElementById(`${name}-count`)!,empty:document.getElementById(`${name}-empty`)!,more:document.getElementById(`${name}-more`) as HTMLButtonElement,visible:PAGE_SIZE,matched:[]}};
  const groups={short:group('short'),video:group('video')};
  const element=(tag:string,className?:string,text?:string)=>{const node=document.createElement(tag);if(className)node.className=className;if(text)node.textContent=text;return node};
  const renderGroup=(type:'short'|'video')=>{const state=groups[type];state.grid.replaceChildren();for(const video of state.matched.slice(0,state.visible)){const isShort=type==='short';const card=element('article',`video-card${isShort?' video-card--short':''}`);const imageLink=element('a','video-card__image') as HTMLAnchorElement;imageLink.href=video.pageUrl;const image=document.createElement('img');image.src=video.imageUrl;image.width=isShort?480:640;image.height=isShort?854:360;image.loading='lazy';image.alt=`${isShort?'Short':'Video'} thumbnail for ${video.title}`;imageLink.append(image);const body=element('div','video-card__body');const date=element('p','eyebrow',`${isShort?'Short':'Video'} · ${new Intl.DateTimeFormat('en-US',{year:'numeric',month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(video.publishedAt))}`);const heading=document.createElement('h3');const detail=document.createElement('a');detail.href=video.pageUrl;detail.textContent=video.title;heading.append(detail);const note=element('p','',video.relatedSongIds.length?`${video.relatedSongIds.length} connected song record${video.relatedSongIds.length===1?'':'s'}`:'No matching song record yet');const links=element('div','video-card__links');const details=document.createElement('a');details.href=video.pageUrl;details.textContent='Details';const watch=document.createElement('a');watch.href=video.watchUrl;watch.textContent='Watch on YouTube ↗';links.append(details,watch);body.append(date,heading,note,links);card.append(imageLink,body);state.grid.append(card)}state.section.hidden=state.matched.length===0;state.count.textContent=`${state.matched.length} ${type==='short'?(state.matched.length===1?'Short':'Shorts'):(state.matched.length===1?'video':'videos')}`;state.empty.hidden=state.matched.length>0;state.more.hidden=state.visible>=state.matched.length;state.grid.setAttribute('aria-busy','false')};
  const apply=()=>{const term=query.value.trim().toLowerCase();const matches=all.filter((video)=>(!term||video.title.toLowerCase().includes(term))&&(connection.value==='all'||(connection.value==='linked'&&video.relatedSongIds.length>0)||(connection.value==='unlinked'&&video.relatedSongIds.length===0)));for(const type of ['short','video'] as const){const state=groups[type];state.visible=PAGE_SIZE;state.matched=matches.filter((video)=>video.videoType===type);state.matched.sort((a,b)=>sort.value==='az'?a.title.localeCompare(b.title):sort.value==='oldest'?Date.parse(a.publishedAt)-Date.parse(b.publishedAt):Date.parse(b.publishedAt)-Date.parse(a.publishedAt));renderGroup(type)}totalCount.textContent=`${groups.short.matched.length} Shorts and ${groups.video.matched.length} videos match (${all.length} total uploads)`;const params=new URLSearchParams();if(term)params.set('q',term);if(connection.value!=='all')params.set('connection',connection.value);if(sort.value!=='channel')params.set('sort',sort.value);history.replaceState(null,'',`${location.pathname}${params.size?`?${params}`:''}`)};
  const params=new URLSearchParams(location.search);query.value=params.get('q')??'';for(const [control,key] of [[connection,'connection'],[sort,'sort']] as const){const value=params.get(key);if(value&&[...control.options].some((option)=>option.value===value))control.value=value}for(const state of Object.values(groups))state.grid.setAttribute('aria-busy','true');fetch('/video-index.json').then((response)=>{if(!response.ok)throw new Error(String(response.status));return response.json()}).then((data)=>{all=data.videos;apply()}).catch(()=>{for(const state of Object.values(groups))state.grid.setAttribute('aria-busy','false');totalCount.textContent='The full video index could not load. The initial catalog remains available.'});for(const control of [query,connection,sort])control.addEventListener(control===query?'input':'change',apply);for(const type of ['short','video'] as const)groups[type].more.addEventListener('click',()=>{groups[type].visible+=PAGE_SIZE;renderGroup(type)});document.getElementById('video-reset')!.addEventListener('click',()=>{query.value='';connection.value='all';sort.value='channel';apply()});
</script>
