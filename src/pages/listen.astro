---
import Base from '../layouts/Base.astro';
import FeaturedReimaginingAlbums from '../components/FeaturedReimaginingAlbums.astro';
import { distributedReleases, platforms, sunoAlbums, sunoPlaylists } from '../data/catalog';

const label: Record<string, string> = {
  acoustic: 'Acoustic',
  electronic: 'Electronic',
  ai: 'Rebuilt with Suno',
  all: 'Everything',
};

const jsonLd = distributedReleases.map((release) => ({
  '@type': 'MusicAlbum',
  name: release.title,
  datePublished: release.released,
  numTracks: release.trackCount,
  byArtist: { '@id': 'https://alexmercedmusic.com/#musicgroup' },
  sameAs: release.links.map((link) => link.url),
}));
---

<Base
  title="Where to listen"
  description="Every place Alex Merced's music is hosted, including Spotify, YouTube, SoundCloud, ReverbNation, Suno and Instagram."
  keywords={['Alex Merced music links', 'Spotify', 'SoundCloud', 'ReverbNation', 'Suno', 'YouTube']}
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="shell">
      <p class="eyebrow">Everywhere it lives</p>
      <h1>Where to listen</h1>
      <p class="lede">
        The catalogue is spread over the platforms it was uploaded to at the time, and
        none of it has been consolidated. This is the whole map, with the counts each
        platform reports.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Current distributed releases</p>
        <h2>Exact links across streaming stores</h2>
        <p>These links were checked against the release title, track list and UPC where available. Some delivery destinations do not publish a stable artist or album page.</p>
      </div>
      <div class="grid grid--3">
        {distributedReleases.map((release) => (
          <article class="card">
            <p class="eyebrow">{release.released} · {release.trackCount} {release.trackCount === 1 ? 'song' : 'songs'}</p>
            <h3>{release.title}</h3>
            {release.upc && <p class="pair__style">UPC {release.upc}</p>}
            <div class="source-links">
              {release.links.map((link) => <a href={link.url}>{link.label} ↗</a>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Start here</p>
        <h2>Hear the originals beside their reimaginings</h2>
        <p>These three albums are the primary listening path for Alex’s acoustic and electronic originals and their new arrangements.</p>
      </div>
      <FeaturedReimaginingAlbums />
    </div>
  </section>

  <section class="section section--tight" data-era="ai">
    <div class="shell">
      <div class="section__head">
        <p class="eyebrow">Curated on Suno</p>
        <h2>{sunoAlbums.length} albums and {sunoPlaylists.length} public playlists</h2>
        <p>Browse official Suno albums and curated collections by project, subject and mood.</p>
      </div>
      <div class="source-links">
        {[...sunoAlbums, ...sunoPlaylists].map((playlist) => <a href={playlist.url}>{playlist.name} · {playlist.songCount} songs ↗</a>)}
      </div>
      <div class="btn-row" style="margin-top:1.4rem"><a class="btn" href="/suno/">Album and playlist artwork and runtimes</a></div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="shell">
      <div class="grid grid--2">
        {platforms.map((p) => (
          <a class="card card--era" data-era={p.era} href={p.url} style="text-decoration:none">
            <p class="eyebrow" style="margin:0;color:var(--era)">{label[p.era]}</p>
            <h3>{p.label}</h3>
            <p>{p.note}</p>
            {p.stat && <p class="pair__style">{p.stat}</p>}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section__head">
        <h2>The rest of the work</h2>
        <p>
          Music is the older half of what Alex does. The current work is data and AI,
          and it lives across a network of sites that all start from
          <a href="https://alexmerced.com">alexmerced.com</a>.
        </p>
      </div>
    </div>
  </section>
</Base>
